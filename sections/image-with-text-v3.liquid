{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id

  assign pad_top_raw = section.settings.padding_top | strip
  assign pad_top_n = pad_top_raw | plus: 0
  if pad_top_raw == blank
    assign pad_top_n = 48
  elsif pad_top_n == 0
    if pad_top_raw != '0'
      assign pad_top_n = 48
    endif
  endif

  assign pad_bottom_raw = section.settings.padding_bottom | strip
  assign pad_bottom_n = pad_bottom_raw | plus: 0
  if pad_bottom_raw == blank
    assign pad_bottom_n = 48
  elsif pad_bottom_n == 0
    if pad_bottom_raw != '0'
      assign pad_bottom_n = 48
    endif
  endif

  assign maxw_raw = section.settings.max_width | strip
  assign maxw_n = maxw_raw | plus: 0
  if maxw_raw == blank
    assign maxw_n = 1200
  elsif maxw_n == 0
    if maxw_raw != '0'
      assign maxw_n = 1200
    endif
  endif
  if maxw_n < 900
    assign maxw_n = 900
  elsif maxw_n > 1600
    assign maxw_n = 1600
  endif

  assign col_gap_raw = section.settings.column_gap | strip
  assign col_gap_n = col_gap_raw | plus: 0
  if col_gap_raw == blank
    assign col_gap_n = 56
  elsif col_gap_n == 0
    if col_gap_raw != '0'
      assign col_gap_n = 56
    endif
  endif

  assign radius_raw = section.settings.image_radius | strip
  assign radius_n = radius_raw | plus: 0
  if radius_raw == blank
    assign radius_n = 12
  elsif radius_n == 0
    if radius_raw != '0'
      assign radius_n = 12
    endif
  endif

  assign btn_radius_raw = section.settings.button_radius | strip
  assign btn_radius_n = btn_radius_raw | plus: 0
  if btn_radius_raw == blank
    assign btn_radius_n = 16
  elsif btn_radius_n == 0
    if btn_radius_raw != '0'
      assign btn_radius_n = 16
    endif
  endif

  assign col_count = section.blocks.size
  if col_count < 1
    assign col_count = 1
  elsif col_count > 3
    assign col_count = 3
  endif

  assign img_aspect = section.settings.image_aspect_ratio | default: '4/5'

  assign btn_align = section.settings.button_align | default: 'center'
  assign btn_justify = 'center'
  if btn_align == 'left'
    assign btn_justify = 'flex-start'
  elsif btn_align == 'right'
    assign btn_justify = 'flex-end'
  endif

  assign needs_ghl = false
  for block in section.blocks
    if block.settings.show_elective_button
      assign needs_ghl = true
      break
    endif
  endfor
-%}

{%- style -%}
  #iwt3-{{ sid }}{
    --iwt3-bg: {{ section.settings.bg_color }};
    --iwt3-text: {{ section.settings.text_color }};
    --iwt3-muted: {{ section.settings.muted_color }};
    --iwt3-maxw: {{ maxw_n }}px;
    --iwt3-col-gap: {{ col_gap_n }}px;
    --iwt3-pad-top: {{ pad_top_n }}px;
    --iwt3-pad-bottom: {{ pad_bottom_n }}px;
    --iwt3-radius: {{ radius_n }}px;
    --iwt3-btn-radius: {{ btn_radius_n }}px;
    --iwt3-btn-justify: {{ btn_justify }};
    --iwt3-img-aspect: {{ img_aspect }};

    --iwt3-title-size: {{ section.settings.title_size | default: '40px' }};
    --iwt3-subtitle-size: {{ section.settings.subtitle_size | default: '20px' }};
    --iwt3-col-title-size: {{ section.settings.col_title_size | default: '32px' }};
    --iwt3-body-size: {{ section.settings.body_size | default: '16px' }};
    --iwt3-items-heading-size: {{ section.settings.items_heading_size | default: '18px' }};
    --iwt3-list-size: {{ section.settings.list_font_size | default: '16px' }};
    --iwt3-price-size: {{ section.settings.price_font_size | default: '22px' }};

    --iwt3-badge-bg: {{ section.settings.badge_bg }};
    --iwt3-badge-text: {{ section.settings.badge_text_color }};
    --iwt3-btn-bg: {{ section.settings.button_bg }};
    --iwt3-btn-text: {{ section.settings.button_text_color }};
    --iwt3-reg-color: {{ section.settings.reg_price_color }};
  }

  #iwt3-{{ sid }}{
    background: var(--iwt3-bg);
    color: var(--iwt3-text);
    padding: var(--iwt3-pad-top) 0 var(--iwt3-pad-bottom);
  }
  @media (max-width: 989px){
    #iwt3-{{ sid }}{
      padding: calc(var(--iwt3-pad-top) / 2) 0 calc(var(--iwt3-pad-bottom) / 2);
    }
  }

  #iwt3-{{ sid }} .iwt3__wrap{
    max-width: var(--iwt3-maxw);
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Section header */
  #iwt3-{{ sid }} .iwt3__top{
    text-align: center;
    margin-bottom: 34px;
  }
  #iwt3-{{ sid }} .iwt3__top-title{
    margin: 0 0 10px 0;
    font-size: var(--iwt3-title-size);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: .01em;
    text-transform: uppercase;
    font-family: var(--font-anton);
  }
  #iwt3-{{ sid }} .iwt3__top-subtitle{
    font-size: var(--iwt3-subtitle-size);
    line-height: 1.35;
    color: var(--iwt3-muted);
    font-family: var(--font-proximaregular);
  }

  /* Grid */
  #iwt3-{{ sid }} .iwt3__grid{
    display: grid;
    gap: var(--iwt3-col-gap);
    align-items: start;
  }
  #iwt3-{{ sid }} .iwt3__grid--cols-1{ grid-template-columns: 1fr; }
  #iwt3-{{ sid }} .iwt3__grid--cols-2{ grid-template-columns: 1fr 1fr; }
  #iwt3-{{ sid }} .iwt3__grid--cols-3{ grid-template-columns: 1fr 1fr 1fr; }

  /* Default per-column layout: image stacked above content. */
  #iwt3-{{ sid }} .iwt3__col,
  #iwt3-{{ sid }} .iwt3__col--stacked{
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Opt-in inline layout: image on the left, content on the right. */
  #iwt3-{{ sid }} .iwt3__col--inline{
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--iwt3-col-gap);
    align-items: center;
  }

  /* Media */
  #iwt3-{{ sid }} .iwt3__mediaWrap{
    position: relative;
    overflow: hidden;
    border-radius: var(--iwt3-radius);
  }
  #iwt3-{{ sid }} .iwt3__img{
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
    aspect-ratio: var(--iwt3-img-aspect, auto);
  }
  #iwt3-{{ sid }} .iwt3__badge{
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--iwt3-badge-bg);
    color: var(--iwt3-badge-text);
    border-radius: 999px;
    padding: 10px 16px;
    text-transform: uppercase;
    line-height: 1;
    font-size: clamp(12px, 2vw, 20px);
    box-shadow: 0 10px 22px rgba(0,0,0,.12);
    white-space: nowrap;
    font-family: "ProximaSanMedium";
  }
  /* Content column */
  #iwt3-{{ sid }} .iwt3__content{
    text-align: center;
  }
  #iwt3-{{ sid }} .iwt3__col-title{
    margin: 0 0 14px 0;
    font-size: var(--iwt3-col-title-size);
    font-weight: 100;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
    font-family: var(--font-anton);
    color: var(--iwt3-text);
  }
  #iwt3-{{ sid }} .iwt3__intro,
  #iwt3-{{ sid }} .iwt3__intro p{
    margin: 0 0 14px 0;
    font-size: var(--iwt3-body-size);
    line-height: 1.45;
    color: var(--iwt3-muted);
    font-family: var(--font-proximaregular);
  }
  #iwt3-{{ sid }} .iwt3__desc,
  #iwt3-{{ sid }} .iwt3__desc p{
    margin: 0 0 18px 0;
    font-size: var(--iwt3-body-size);
    line-height: 1.55;
    color: var(--iwt3-text);
    font-family: var(--font-proximaregular);
  }
  #iwt3-{{ sid }} .iwt3__items-heading{
    margin: 0 0 12px 0;
    font-size: var(--iwt3-items-heading-size);
    font-weight: 600;
    line-height: 1.3;
    color: var(--iwt3-text);
    font-family: var(--font-proximamedium);
  }
  #iwt3-{{ sid }} .iwt3__list{
    display: flex;
    justify-content: center;
    margin: 0 0 18px 0;
  }
  #iwt3-{{ sid }} .iwt3__list ul{
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    text-align: left;
  }
  #iwt3-{{ sid }} .iwt3__list li{
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--iwt3-list-size);
    line-height: 1.4;
    color: var(--iwt3-text);
    font-family: "ProximaNova";
  }
  #iwt3-{{ sid }} .iwt3__list li::before{
    content: "";
    width: 6px;
    height: 6px;
    margin-top: 9px;
    flex: 0 0 6px;
    background: var(--iwt3-text);
    border-radius: 50%;
  }
  #iwt3-{{ sid }} .iwt3__closing,
  #iwt3-{{ sid }} .iwt3__closing p{
    margin: 14px 0 0 0;
    font-size: var(--iwt3-body-size);
    line-height: 1.45;
    color: var(--iwt3-text);
    font-family: var(--font-proximaregular);
  }

  /* Prices */
  #iwt3-{{ sid }} .iwt3__prices{
    margin-top: 22px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 22px;
    align-items: baseline;
    font-size: var(--iwt3-price-size);
    font-weight: 500;
    text-transform: uppercase;
    font-family: var(--font-proximamedium);
  }
  #iwt3-{{ sid }} .iwt3__prices .reg{
    color: var(--iwt3-reg-color);
    text-decoration: line-through;
    text-decoration-thickness: 3px;
    font-size: clamp(12px, 2vw, 20px);
  }

  /* CTA buttons */
  #iwt3-{{ sid }} .iwt3__cta{
    margin-top: 22px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--iwt3-btn-justify);
  }
  /* #iwt3-{{ sid }} .iwt3__btn{
    border-radius: var(--iwt3-btn-radius);
    padding: 0 32px;
    text-transform: uppercase;
    letter-spacing: .02em;
    white-space: nowrap;
    font-family: Montserrat, var(--font-proximamedium);
    font-size: 16px;
  } */
  #iwt3-{{ sid }} .financing-btn-inline{
    color: #141414;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.12px;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0 16px;
    position: relative;
  }
  #iwt3-{{ sid }} .financing-btn-inline::before{
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: #01241E;
  }

  /* Mobile: everything stacks single-column */
  @media (max-width: 989px){
    #iwt3-{{ sid }} .iwt3__grid,
    #iwt3-{{ sid }} .iwt3__col--inline,
    #iwt3-{{ sid }} .iwt3__grid--cols-2,
    #iwt3-{{ sid }} .iwt3__grid--cols-3{
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #iwt3-{{ sid }} .iwt3__top{
      margin-bottom: 22px;
    }
    #iwt3-{{ sid }} .iwt3__cta{
      flex-direction: column;
      align-items: stretch;
    }
    #iwt3-{{ sid }} .iwt3__btn,
    #iwt3-{{ sid }} .financing-btn-inline{
      width: 100%;
      font-size: 14px;
      padding: 0 24px;
    }
    #iwt3-{{ sid }} .iwt3__badge{
      font-size: 14px;
      padding: 8px 12px;
    }
  }
{%- endstyle -%}

<section id="iwt3-{{ sid }}" class="section">
  <div class="iwt3__wrap">
    {%- if section.settings.top_title != blank or section.settings.top_subtitle != blank -%}
      <div class="iwt3__top">
        {%- if section.settings.top_title != blank -%}
          <h2 class="iwt3__top-title">{{ section.settings.top_title }}</h2>
        {%- endif -%}
        {%- if section.settings.top_subtitle != blank -%}
          <div class="iwt3__top-subtitle rte">{{ section.settings.top_subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="iwt3__grid iwt3__grid--cols-{{ col_count }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'column' -%}
            {%- liquid
              assign col_layout = block.settings.column_layout | default: 'auto'
              if col_layout == 'auto'
                if col_count == 1
                  assign col_layout = 'inline'
                else
                  assign col_layout = 'stacked'
                endif
              endif
            -%}
            <article class="iwt3__col iwt3__col--{{ col_layout }}" {{ block.shopify_attributes }}>
              <div class="iwt3__media">
                <div class="iwt3__mediaWrap">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        class: 'iwt3__img',
                        sizes: '(min-width: 990px) 45vw, 92vw'
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'iwt3__img placeholder-svg' }}
                  {%- endif -%}

                  {%- if block.settings.badge_text != blank -%}
                    <div class="iwt3__badge">{{ block.settings.badge_text }}</div>
                  {%- endif -%}
                </div>
              </div>

              <div class="iwt3__content">
                {%- if block.settings.column_title != blank -%}
                  <h3 class="iwt3__col-title">{{ block.settings.column_title }}</h3>
                {%- endif -%}

                {%- if block.settings.intro_text != blank -%}
                  <div class="iwt3__intro rte">{{ block.settings.intro_text }}</div>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="iwt3__desc rte">{{ block.settings.description }}</div>
                {%- endif -%}

                {%- if block.settings.items_heading != blank -%}
                  <p class="iwt3__items-heading">{{ block.settings.items_heading }}</p>
                {%- endif -%}

                {%- if block.settings.items_list != blank -%}
                  <div class="iwt3__list rte">{{ block.settings.items_list }}</div>
                {%- endif -%}

                {%- if block.settings.closing_text != blank -%}
                  <div class="iwt3__closing rte">{{ block.settings.closing_text }}</div>
                {%- endif -%}

                {%- if block.settings.sale_price != blank or block.settings.reg_price != blank -%}
                  <div class="iwt3__prices">
                    {%- if block.settings.sale_price != blank -%}
                      <div class="sale">{{ block.settings.sale_label }} <span>{{ block.settings.sale_price }}</span></div>
                    {%- endif -%}
                    {%- if block.settings.reg_price != blank -%}
                      <div class="reg">{{ block.settings.reg_label }} <span>{{ block.settings.reg_price }}</span></div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_label != blank or block.settings.show_elective_button -%}
                  <div class="iwt3__cta">
                    {%- if block.settings.button_label != blank -%}
                      <a
                        class="iwt3__btn btn button-yg"
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                      >
                        <span class="btn-label-down">{{ block.settings.button_label }}</span>
                        <span class="btn-label-down">{{ block.settings.button_label }}</span>
                      </a>
                    {%- endif -%}

                    {%- if block.settings.show_elective_button -%}
                      <a
                        href="{{ block.settings.elective_link | default: '/pages/payment-plan-options' }}"
                        class="btn button-b financing-btn-inline"
                        data-elective-financing-link
                        {% if block.settings.elective_product_handle != blank %}
                          data-product-handle="{{ block.settings.elective_product_handle }}"
                        {% endif %}
                        {% if block.settings.elective_product_id != blank %}
                          data-product-id="{{ block.settings.elective_product_id }}"
                        {% endif %}
                        {% if block.settings.elective_new_tab %}
                          target="_blank"
                          rel="noopener"
                        {% endif %}
                      >
                        <span class="btn-label-down">{{ block.settings.elective_button_label | default: "Elective Financing Options" }}</span>
                        <span class="btn-label-down">{{ block.settings.elective_button_label | default: "Elective Financing Options" }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if needs_ghl -%}
  {% render 'ghl-finance-modal' %}

  <script>
  (function(){
    if (window.__iwt3GhlBound) return;
    window.__iwt3GhlBound = true;

    const LINK_SEL = '[data-elective-financing-link]';
    const GHL_FORM_ID = 'jbeQYeHWMI1dM9tX0mYF';
    const GHL_BASE = `https://app.npta.ca/widget/form/${GHL_FORM_ID}`;
    const MODAL_ID = 'ghlFinanceModal';
    const MOUNT_ID = 'ghlFormMount';
    const TARGET_KEY = 'npta_finance_target';
    const SUBMITTED_KEY = 'npta_finance_submitted_ts';
    const SUBMIT_TTL_DAYS = 0;

    function getModal(){ return document.getElementById(MODAL_ID); }
    function getMount(){ return document.getElementById(MOUNT_ID); }

    function openModal(){
      const m = getModal();
      if(!m) return;
      m.hidden = false;
      m.setAttribute('aria-hidden','false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(opts){
      const m = getModal();
      if(!m) return;
      m.hidden = true;
      m.setAttribute('aria-hidden','true');
      document.body.style.overflow = '';
      const mount = getMount();
      if (mount && (!opts || opts.clear !== false)) mount.innerHTML = '';
    }

    function isSubmitted(){
      try {
        const v = localStorage.getItem(SUBMITTED_KEY);
        if (!v) return false;
        const ts = parseInt(v, 10);
        if (!Number.isFinite(ts)) return true;
        if (SUBMIT_TTL_DAYS && SUBMIT_TTL_DAYS > 0) {
          const ttlMs = SUBMIT_TTL_DAYS * 24 * 60 * 60 * 1000;
          if (Date.now() - ts > ttlMs) return false;
        }
        return true;
      } catch(e){
        return false;
      }
    }

    function toQuery(obj){
      return Object.keys(obj || {})
        .filter(k => obj[k] != null && obj[k] !== '')
        .map(k => encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]))
        .join('&');
    }

    function buildTarget(href, a){
      const u = new URL(href, window.location.origin);
      const q = u.searchParams;
      if (a.dataset.productHandle) q.set('product_handle', a.dataset.productHandle);
      if (a.dataset.productId) q.set('product_id', a.dataset.productId);
      const title = a.dataset.productTitle || document.title || '';
      if (title) q.set('product_title', title);
      u.search = q.toString();
      return u.toString();
    }

    function buildFormSrc(a){
      const attr = (window.__nptaGetAttribution && window.__nptaGetAttribution()) || {};
      const utm = {
        utm_source: attr.utm_source || '',
        utm_medium: attr.utm_medium || '',
        utm_campaign: attr.utm_campaign || '',
        utm_term: attr.utm_term || '',
        utm_content: attr.utm_content || ''
      };
      const prod = {
        product_title: a.dataset.productTitle || document.title || '',
        product_handle: a.dataset.productHandle || '',
        product_id: a.dataset.productId || ''
      };
      const qs = [toQuery(utm), toQuery(prod)].filter(Boolean).join('&');
      return qs ? (GHL_BASE + '?' + qs) : GHL_BASE;
    }

    function injectIframe(src){
      const mount = getMount();
      if(!mount) return;
      mount.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.style.width = '100%';
      iframe.style.border = 'none';
      iframe.style.display = 'block';
      mount.appendChild(iframe);
    }

    function handleClick(e){
      e.preventDefault();
      const a = e.currentTarget;
      if(isSubmitted()){
        const url = buildTarget(a.href, a);
        window.open(url, a.target === '_blank' ? '_blank' : '_self');
        return;
      }
      const src = buildFormSrc(a);
      try { localStorage.setItem(TARGET_KEY, a.href); } catch(err){}
      injectIframe(src);
      openModal();
    }

    function listenForSubmit(){
      window.addEventListener('message', (evt) => {
        if(!evt.data || typeof evt.data !== 'object') return;
        if(evt.data.type === 'hsFormCallback' && evt.data.eventName === 'onFormSubmitted'){
          try{
            localStorage.setItem(SUBMITTED_KEY, String(Date.now()));
            const target = localStorage.getItem(TARGET_KEY);
            if(target){
              closeModal({ clear: false });
              setTimeout(() => { window.location.href = target; }, 300);
            }
          } catch(e){}
        }
      }, false);
    }

    function init(){
      listenForSubmit();
      const links = document.querySelectorAll(LINK_SEL);
      links.forEach(link => {
        if (link.__iwt3Bound) return;
        link.__iwt3Bound = true;
        link.addEventListener('click', handleClick);
      });
      const closers = document.querySelectorAll('[data-close-ghl]');
      closers.forEach(el => el.addEventListener('click', () => closeModal()));
    }

    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Image with text V3",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Section header (shared across columns)" },
    { "type": "text", "id": "top_title", "label": "Top title" },
    { "type": "richtext", "id": "top_subtitle", "label": "Top subtitle" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0B2B24" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#5A6A66" },
