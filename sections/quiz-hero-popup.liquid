<section
  id="QuizHeroPopup-{{ section.id }}"
  class="qhp qhp--{{ section.id }}"
  data-qhp-root
  style="
    --qhp-bg: {{ section.settings.section_bg }};
    --qhp-heading: {{ section.settings.heading_color }};
    --qhp-text: {{ section.settings.text_color }};
    --qhp-primary-bg: {{ section.settings.primary_btn_bg }};
    --qhp-primary-text: {{ section.settings.primary_btn_text }};
    --qhp-secondary-bg: {{ section.settings.secondary_btn_bg }};
    --qhp-secondary-text: {{ section.settings.secondary_btn_text }};
    --qhp-modal-bg: {{ section.settings.modal_bg }};
    --qhp-accent: {{ section.settings.accent_color }};
    --qhp-correct: {{ section.settings.correct_color }};
    --qhp-wrong: {{ section.settings.wrong_color }};
  "
>
  <style>
    .qhp{
      background: var(--qhp-bg);
      color: var(--qhp-text);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    .qhp .qhp__container{
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .qhp .qhp__grid{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }

    .qhp .qhp__content{ max-width: 560px; }

    .qhp .qhp__eyebrow{
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: .85;
      margin: 0 0 10px;
    }

    .qhp .qhp__heading{
      font-size: clamp(28px, 3.3vw, 44px);
      line-height: 1.05;
      margin: 0 0 14px;
      color: var(--qhp-heading);
      font-weight: 800;
      text-transform: uppercase;
    }

    .qhp .qhp__desc{
      font-size: 16px;
      line-height: 1.55;
      margin: 0 0 22px;
      max-width: 520px;
      opacity: .95;
    }

    .qhp .qhp__actions{
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin: 0 0 26px;
    }

    .qhp .qhp__btn{
      appearance: none;
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      font-weight: 800;
      letter-spacing: .02em;
      cursor: pointer;
      transition: transform .12s ease, opacity .12s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
    }
    .qhp .qhp__btn:active{ transform: translateY(1px); }
    .qhp .qhp__btn:hover{ opacity: .92; }
    .qhp .qhp__btn[disabled]{ opacity: .6; cursor: not-allowed; }

    .qhp .qhp__btn--primary{ background: var(--qhp-primary-bg); color: var(--qhp-primary-text); }
    .qhp .qhp__btn--secondary{ background: var(--qhp-secondary-bg); color: var(--qhp-secondary-text); }

    .qhp .qhp__advisor{ margin-top: 10px; font-size: 15px; opacity: .95; }

    .qhp .qhp__media{
      border-radius: 18px;
      overflow: hidden;
      background: rgba(0,0,0,.04);
      min-height: 260px;
    }
    .qhp .qhp__media img{
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    @media (max-width: 900px){
      .qhp .qhp__grid{ grid-template-columns: 1fr; }
      .qhp .qhp__content{ max-width: 100%; }
      .qhp .qhp__media{ min-height: 220px; }
    }

    /* Modal */
    .qhp .qhp__backdrop{
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      opacity: 0;
      visibility: hidden;
      transition: opacity .18s ease, visibility .18s ease;
      z-index: 9998;
    }
    .qhp .qhp__modal{
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 18px;
      opacity: 0;
      visibility: hidden;
      transition: opacity .18s ease, visibility .18s ease;
      z-index: 9999;
    }
    .qhp.qhp--open .qhp__backdrop,
    .qhp.qhp--open .qhp__modal{
      opacity: 1;
      visibility: visible;
    }

    .qhp .qhp__dialog{
      width: min(900px, 100%);
      max-height: 90vh;
      overflow: auto;
      background: var(--qhp-modal-bg);
      border-radius: 18px;
      box-shadow: 0 18px 60px rgba(0,0,0,.25);
      border: 1px solid rgba(0,0,0,.08);
    }

    .qhp .qhp__dialogHeader{
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 18px;
      border-bottom: 1px solid rgba(0,0,0,.08);
      position: sticky;
      top: 0;
      background: var(--qhp-modal-bg);
      z-index: 2;
    }

    .qhp .qhp__dialogTitle{
      margin: 0;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: .02em;
      color: var(--qhp-heading);
    }
    .qhp .qhp__dialogClose{
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid rgba(0,0,0,.12);
      background: rgba(0,0,0,.03);
      cursor: pointer;
      display: grid;
      place-items: center;
    }

    .qhp .qhp__dialogBody{ padding: 18px; }

    /* Lead gate + Send status */
    .qhp [data-qhp-quiz-ui]{ display:none; }
    .qhp.qhp--started [data-qhp-quiz-ui]{ display:block; }
    .qhp.qhp--started [data-qhp-lead]{ display:none; }

    .qhp .qhp__leadCard{
      background:#fff;
      border:1px solid rgba(0,0,0,.08);
      border-radius:16px;
      padding:16px;
      margin-bottom:14px;
    }
    .qhp .qhp__leadTitle{
      margin:0 0 6px;
      font-size:18px;
      font-weight:1000;
      color:var(--qhp-heading);
    }
    .qhp .qhp__leadDesc{ margin:0 0 12px; opacity:.9; }

    .qhp .qhp__fieldGrid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
      margin-bottom: 12px;
    }
    @media(max-width:720px){
      .qhp .qhp__fieldGrid{ grid-template-columns:1fr; }
    }
    .qhp .qhp__label{
      display:block;
      font-size:12px;
      font-weight:900;
      letter-spacing:.02em;
      margin-bottom:6px;
      color:var(--qhp-heading);
    }
    .qhp .qhp__input{
      width:100%;
      border-radius:12px;
      border:1px solid rgba(0,0,0,.14);
      padding:12px 12px;
      font-weight:700;
      outline:none;
    }
    .qhp .qhp__input:focus{
      border-color:var(--qhp-accent);
      box-shadow:0 0 0 3px rgba(15,130,140,.18);
    }
    .qhp .qhp__leadError{
      margin:10px 0 0;
      color:#b42318;
      font-weight:800;
      display:none;
    }
    .qhp .qhp__leadError.is-visible{ display:block; }

    .qhp .qhp__sendStatus{
      margin:10px 0 0;
      font-weight:800;
      opacity:.95;
    }
    .qhp .qhp__hp{
      position:absolute!important;
      left:-9999px!important;
      top:auto!important;
      width:1px!important;
      height:1px!important;
      overflow:hidden!important;
    }

    /* Quiz UI */
    .qhp .qhp__quizHeader{
      background: rgba(0,0,0,.03);
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 14px;
    }
    .qhp .qhp__quizH1{
      margin: 0 0 6px;
      font-size: 22px;
      color: var(--qhp-heading);
      font-weight: 900;
    }
    .qhp .qhp__quizSub{ margin: 0; font-size: 14px; opacity: .9; }

    .qhp .qhp__progressCard{
      background: #fff;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 14px;
    }
    .qhp .qhp__progressRow{
      display:flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 800;
      color: var(--qhp-heading);
    }
    .qhp .qhp__bar{
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: rgba(0,0,0,.08);
      overflow: hidden;
    }
    .qhp .qhp__barFill{
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--qhp-accent), rgba(0,0,0,.25));
      border-radius: 999px;
      transition: width .35s ease;
    }

    .qhp .qhp__questionCard{
      background: #fff;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 16px;
    }
    .qhp .qhp__qTitle{
      margin: 0 0 14px;
      font-size: 18px;
      font-weight: 900;
      color: var(--qhp-heading);
    }

    .qhp .qhp__options{
      display: grid;
      gap: 10px;
      margin: 0 0 14px;
    }
    .qhp .qhp__option{
      width: 100%;
      text-align: left;
      border-radius: 14px;
      border: 2px solid rgba(0,0,0,.10);
      padding: 12px 12px;
      background: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      transition: border-color .12s ease, background .12s ease, transform .12s ease;
      font-weight: 700;
      color: #0d2b28;
    }
    .qhp .qhp__option:hover{ border-color: var(--qhp-accent); background: rgba(0,0,0,.02); }
    .qhp .qhp__option[disabled]{ cursor: not-allowed; opacity: .95; }

    .qhp .qhp__option--correct{
      border-color: var(--qhp-correct);
      background: rgba(0,0,0,.02);
      background: color-mix(in srgb, var(--qhp-correct) 15%, #fff);
    }
    .qhp .qhp__option--wrong{
      border-color: var(--qhp-wrong);
      background: rgba(0,0,0,.02);
      background: color-mix(in srgb, var(--qhp-wrong) 12%, #fff);
    }

    .qhp .qhp__badge{
      display: inline-flex;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 900;
      border: 1px solid rgba(0,0,0,.12);
      background: rgba(0,0,0,.03);
      flex: 0 0 auto;
    }

    .qhp .qhp__feedback{
      border-radius: 14px;
      padding: 14px;
      border: 2px solid rgba(0,0,0,.10);
      background: rgba(0,0,0,.02);
      display: none;
      margin-bottom: 12px;
    }
    .qhp .qhp__feedback.is-visible{ display:block; }
    .qhp .qhp__feedbackTitle{
      margin: 0 0 6px;
      font-weight: 900;
      color: var(--qhp-heading);
    }
    .qhp .qhp__feedbackText{ margin: 0; line-height: 1.5; }

    .qhp .qhp__next{
      width: 100%;
      border-radius: 14px;
      padding: 14px 16px;
      background: var(--qhp-heading);
      color: #fff;
      border: 0;
      font-weight: 900;
      cursor: pointer;
      display: none;
    }
    .qhp .qhp__next.is-visible{ display:block; }
    .qhp .qhp__next:hover{ opacity: .92; }

    .qhp .qhp__powered{
      text-align:center;
      margin-top: 12px;
      font-size: 12px;
      opacity: .8;
    }

    /* Results */
    .qhp .qhp__results{ display:none; }
    .qhp .qhp__results.is-visible{ display:block; }

    .qhp .qhp__resultTop{
      text-align:center;
      padding: 10px 0 6px;
    }
    .qhp .qhp__trophy{
      width: 74px;
      height: 74px;
      border-radius: 999px;
      margin: 0 auto 10px;
      display:grid;
      place-items:center;
      background: linear-gradient(135deg, var(--qhp-accent), rgba(0,0,0,.25));
      color: #fff;
      font-size: 34px;
      font-weight: 900;
    }
    .qhp .qhp__resultTitle{
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 1000;
      color: var(--qhp-heading);
    }
    .qhp .qhp__resultScore{
      font-size: 46px;
      font-weight: 1000;
      color: var(--qhp-accent);
      margin: 0 0 4px;
    }
    .qhp .qhp__resultPct{
      margin: 0;
      opacity: .9;
      font-weight: 800;
    }
    .qhp .qhp__resultMsg{
      background: rgba(0,0,0,.03);
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 14px;
      margin: 14px 0;
      line-height: 1.6;
    }
    .qhp .qhp__resultBtns{
      display:grid;
      gap: 10px;
    }
    .qhp .qhp__linkBtn{
      width: 100%;
      border-radius: 14px;
      padding: 14px 16px;
      text-decoration: none;
      text-align:center;
      font-weight: 1000;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height: 46px;
      border: 0;
      cursor: pointer;
    }
    .qhp .qhp__linkBtn--cta{ background: var(--qhp-accent); color: #fff; }
    .qhp .qhp__linkBtn--retake{ background: rgba(0,0,0,.08); color: #111; }
    .qhp .qhp__linkBtn[disabled]{ opacity:.6; cursor:not-allowed; }
  </style>

  <div class="qhp__container">
    <div class="qhp__grid">
      <div class="qhp__content">
        {% if section.settings.eyebrow != blank %}
          <p class="qhp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="qhp__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="qhp__desc">{{ section.settings.description }}</div>
        {% endif %}

        <div class="qhp__actions">
          <button
            type="button"
            class="qhp__btn qhp__btn--primary"
            data-qhp-open
            {% if section.blocks.size == 0 %}disabled{% endif %}
          >
            {{ section.settings.primary_btn_label }}
          </button>

          {% if section.settings.secondary_btn_label != blank and section.settings.secondary_btn_url != blank %}
            <a class="qhp__btn qhp__btn--secondary" href="{{ section.settings.secondary_btn_url }}">
              {{ section.settings.secondary_btn_label }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.advisor_text != blank %}
          <div class="qhp__advisor">{{ section.settings.advisor_text }}</div>
        {% endif %}
      </div>

      <div class="qhp__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 900px) 50vw, 100vw',
              alt: section.settings.image.alt | escape
          }}
        {% else %}
          <div style="padding: 26px; opacity: .7;">
            Upload an image in section settings.
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Backdrop + Modal -->
  <div class="qhp__backdrop" data-qhp-backdrop aria-hidden="true"></div>

  <div class="qhp__modal" data-qhp-modal aria-hidden="true">
    <div class="qhp__dialog" role="dialog" aria-modal="true" aria-label="Quiz">
      <div class="qhp__dialogHeader">
        <h3 class="qhp__dialogTitle">{{ section.settings.quiz_title }}</h3>
        <button type="button" class="qhp__dialogClose" data-qhp-close aria-label="Close">✕</button>
      </div>

      <div class="qhp__dialogBody">
        <!-- Quiz View -->
        <div class="qhp__quiz" data-qhp-quiz>

          <!-- Lead Gate (Name + Email) -->
          <div class="qhp__lead" data-qhp-lead>
            <div class="qhp__leadCard">
              <h4 class="qhp__leadTitle">{{ section.settings.lead_title }}</h4>
              <p class="qhp__leadDesc">{{ section.settings.lead_desc }}</p>

              <div class="qhp__fieldGrid">
                <label>
                  <span class="qhp__label">{{ section.settings.lead_name_label }}</span>
                  <input class="qhp__input" type="text" data-qhp-lead-name placeholder="{{ section.settings.lead_name_placeholder | escape }}">
                </label>

                <label>
                  <span class="qhp__label">{{ section.settings.lead_email_label }}</span>
                  <input class="qhp__input" type="email" data-qhp-lead-email placeholder="{{ section.settings.lead_email_placeholder | escape }}">
                </label>
              </div>

              <p class="qhp__leadError" data-qhp-lead-error></p>

              <button type="button" class="qhp__btn qhp__btn--primary" data-qhp-start>
                {{ section.settings.lead_start_label }}
              </button>
            </div>
          </div>

          <!-- Quiz UI (hidden until started when lead is enabled) -->
          <div data-qhp-quiz-ui>
            <div class="qhp__quizHeader">
              <h4 class="qhp__quizH1">{{ section.settings.quiz_header }}</h4>
              <p class="qhp__quizSub">{{ section.settings.quiz_subheader }}</p>
            </div>

            <div class="qhp__progressCard">
              <div class="qhp__progressRow">
                <span data-qhp-progress-text>Question 1 of 1</span>
                <span data-qhp-score-text>Score: 0/0</span>
              </div>
              <div class="qhp__bar"><div class="qhp__barFill" data-qhp-bar></div></div>
            </div>

            <div class="qhp__questionCard">
              <h5 class="qhp__qTitle" data-qhp-question></h5>

              <div class="qhp__options" data-qhp-options></div>

              <div class="qhp__feedback" data-qhp-feedback>
                <p class="qhp__feedbackTitle" data-qhp-feedback-title></p>
                <p class="qhp__feedbackText" data-qhp-feedback-text></p>
              </div>

              <button class="qhp__next" type="button" data-qhp-next>Next</button>
            </div>

            <div class="qhp__powered">{{ section.settings.powered_by }}</div>
          </div>
        </div>

        <!-- Results View -->
        <div class="qhp__results" data-qhp-results>
          <div class="qhp__resultTop">
            <div class="qhp__trophy">🏆</div>
            <h4 class="qhp__resultTitle" data-qhp-result-title></h4>
            <p class="qhp__resultScore" data-qhp-result-score></p>
            <p class="qhp__resultPct" data-qhp-result-pct></p>
          </div>

          <div class="qhp__resultMsg">
            <div data-qhp-result-message></div>
            <div style="margin-top:10px;font-weight:900;color:var(--qhp-heading)" data-qhp-result-cta></div>
          </div>

          <div class="qhp__resultBtns">
            {% if section.settings.send_enabled %}
              <button class="qhp__linkBtn qhp__linkBtn--cta" type="button" data-qhp-send>
                {{ section.settings.send_btn_label }}
              </button>
              <div class="qhp__sendStatus" data-qhp-send-status></div>
            {% endif %}

            {% if section.settings.results_cta_label != blank and section.settings.results_cta_url != blank %}
              <a class="qhp__linkBtn qhp__linkBtn--cta" href="{{ section.settings.results_cta_url }}">
                {{ section.settings.results_cta_label }}
              </a>
            {% endif %}

            <button class="qhp__linkBtn qhp__linkBtn--retake" type="button" data-qhp-retake>
              {{ section.settings.retake_label }}
            </button>
          </div>

          <div class="qhp__powered" style="margin-top:10px">{{ section.settings.powered_by }}</div>
        </div>

        <!-- Hidden Shopify contact form (emails store customer email) -->
        <form data-qhp-submit-form method="post" action="/contact" accept-charset="UTF-8" style="display:none;">
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[name]" data-qhp-form-name>
          <input type="hidden" name="contact[email]" data-qhp-form-email>
          <input type="hidden" name="contact[subject]" value="Quiz Result Submission">
          <textarea name="contact[body]" data-qhp-form-body></textarea>

          <!-- Honeypot -->
          <input class="qhp__hp" type="text" name="contact[company]" tabindex="-1" autocomplete="off" aria-hidden="true">
        </form>

        <script type="application/json" data-qhp-questions>
          [
            {%- for block in section.blocks -%}
              {
                "question": {{ block.settings.question | json }},
                "options_raw": {{ block.settings.options | json }},
                "correct": {{ block.settings.correct_option | plus: 0 }},
                "explanation": {{ block.settings.explanation | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>

        <script>
          (function(){
            var root = document.getElementById('QuizHeroPopup-{{ section.id }}');
            if(!root) return;

            var leadEnabled = {{ section.settings.lead_enabled | json }};
            var sendEnabled = {{ section.settings.send_enabled | json }};
            var sendMode = {{ section.settings.send_mode | json }}; // "auto" or "button"

            var msgLeadRequired = {{ section.settings.lead_required_msg | json }};
            var msgSendSuccess = {{ section.settings.send_success_text | json }};
            var msgSendError = {{ section.settings.send_error_text | json }};

            var openBtns = root.querySelectorAll('[data-qhp-open]');
            var backdrop = root.querySelector('[data-qhp-backdrop]');
            var modal = root.querySelector('[data-qhp-modal]');
            var closeBtn = root.querySelector('[data-qhp-close]');

            var quizWrap = root.querySelector('[data-qhp-quiz]');
            var resultsWrap = root.querySelector('[data-qhp-results]');

            var qText = root.querySelector('[data-qhp-question]');
            var optionsWrap = root.querySelector('[data-qhp-options]');
            var feedback = root.querySelector('[data-qhp-feedback]');
            var feedbackTitle = root.querySelector('[data-qhp-feedback-title]');
            var feedbackText = root.querySelector('[data-qhp-feedback-text]');
            var nextBtn = root.querySelector('[data-qhp-next]');

            var progressText = root.querySelector('[data-qhp-progress-text]');
            var scoreText = root.querySelector('[data-qhp-score-text]');
            var bar = root.querySelector('[data-qhp-bar]');

            var resTitle = root.querySelector('[data-qhp-result-title]');
            var resScore = root.querySelector('[data-qhp-result-score]');
            var resPct = root.querySelector('[data-qhp-result-pct]');
            var resMsg = root.querySelector('[data-qhp-result-message]');
            var resCta = root.querySelector('[data-qhp-result-cta]');
            var retakeBtn = root.querySelector('[data-qhp-retake]');

            // Lead UI
            var leadNameInput = root.querySelector('[data-qhp-lead-name]');
            var leadEmailInput = root.querySelector('[data-qhp-lead-email]');
            var leadStartBtn = root.querySelector('[data-qhp-start]');
            var leadError = root.querySelector('[data-qhp-lead-error]');

            // Submit UI
            var sendBtn = root.querySelector('[data-qhp-send]');
            var sendStatus = root.querySelector('[data-qhp-send-status]');
            var submitForm = root.querySelector('[data-qhp-submit-form]');
            var formName = root.querySelector('[data-qhp-form-name]');
            var formEmail = root.querySelector('[data-qhp-form-email]');
            var formBody = root.querySelector('[data-qhp-form-body]');

            var dataEl = root.querySelector('script[type="application/json"][data-qhp-questions]');
            var raw = [];
            try { raw = JSON.parse(dataEl.textContent || '[]'); } catch(e){ raw = []; }

            // Normalize questions
            var questions = raw.map(function(q){
              var opts = (q.options_raw || '')
                .split('\n')
                .map(function(s){ return (s || '').trim(); })
                .filter(Boolean);
              return {
                question: q.question || '',
                options: opts,
                correct: Math.max(0, (parseInt(q.correct,10) || 1) - 1), // 1-based -> 0-based
                explanation: q.explanation || ''
              };
            }).filter(function(q){ return q.question && q.options.length >= 2; });

            // State
            var started = false;
            var lead = { name: '', email: '' };

            var idx = 0;
            var selected = null;
            var showFeedback = false;
            var score = 0;

            var correctByQ = []; // boolean per question
            var sent = false;

            var closeResets = {{ section.settings.close_resets | json }};

            function lockScroll(locked){
              if(locked){
                root._qhpPrevOverflow = document.body.style.overflow;
                document.body.style.overflow = 'hidden';
              } else {
                document.body.style.overflow = root._qhpPrevOverflow || '';
              }
            }

            function openModal(){
              if(!questions.length) return;

              root.classList.add('qhp--open');
              backdrop.setAttribute('aria-hidden','false');
              modal.setAttribute('aria-hidden','false');
              lockScroll(true);

              resultsWrap.classList.remove('is-visible');
              resultsWrap.style.display = 'none';
              quizWrap.style.display = '';

              if(leadEnabled){
                root.classList.remove('qhp--started');
                started = false;
                if(leadError){ leadError.classList.remove('is-visible'); leadError.textContent=''; }
              } else {
                started = true;
                root.classList.add('qhp--started');
              }

              resetQuizStateOnly();
              setTimeout(function(){ closeBtn && closeBtn.focus(); }, 0);
            }

            function closeModal(){
              root.classList.remove('qhp--open');
              backdrop.setAttribute('aria-hidden','true');
              modal.setAttribute('aria-hidden','true');
              lockScroll(false);

              if(closeResets){
                resetAll();
              }
            }

            function resetQuizStateOnly(){
              idx = 0;
              selected = null;
              showFeedback = false;
              score = 0;
              correctByQ = [];
              sent = false;

              if(sendStatus) sendStatus.textContent = '';
              if(sendBtn) sendBtn.disabled = false;

              feedback.classList.remove('is-visible');
              nextBtn.classList.remove('is-visible');

              render();
            }

            function resetAll(){
              lead = { name:'', email:'' };
              if(leadNameInput) leadNameInput.value = '';
              if(leadEmailInput) leadEmailInput.value = '';
              if(leadError){ leadError.classList.remove('is-visible'); leadError.textContent=''; }

              started = !leadEnabled;
              root.classList.toggle('qhp--started', started);

              resetQuizStateOnly();
            }

            function updateProgress(){
              var total = questions.length;
              progressText.textContent = 'Question ' + (idx + 1) + ' of ' + total;
              var answeredCount = idx + (showFeedback ? 1 : 0);
              scoreText.textContent = 'Score: ' + score + '/' + (answeredCount || 0);
              bar.style.width = ((idx + 1) / total * 100) + '%';
            }

            function clearOptions(){
              while(optionsWrap.firstChild) optionsWrap.removeChild(optionsWrap.firstChild);
            }

            function makeOptionBtn(label, optIndex){
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'qhp__option';
              btn.setAttribute('data-opt', String(optIndex));

              var left = document.createElement('span');
              left.textContent = label;

              var badge = document.createElement('span');
              badge.className = 'qhp__badge';
              badge.textContent = '';

              btn.appendChild(left);
              btn.appendChild(badge);

              btn.addEventListener('click', function(){
                if(showFeedback) return;

                selected = optIndex;
                showFeedback = true;

                var isCorrect = selected === questions[idx].correct;
                correctByQ[idx] = isCorrect;

                if(isCorrect) score++;

                renderFeedback();
                renderOptionsState();
                nextBtn.classList.add('is-visible');
                updateProgress();
              });

              return btn;
            }

            function renderOptionsState(){
              var q = questions[idx];
              var buttons = optionsWrap.querySelectorAll('.qhp__option');

              buttons.forEach(function(b){
                b.disabled = true;
                var i = parseInt(b.getAttribute('data-opt'), 10);
                var badge = b.querySelector('.qhp__badge');

                b.classList.remove('qhp__option--correct','qhp__option--wrong');
                if(badge) badge.textContent = '';

                if(showFeedback){
                  if(i === q.correct){
                    b.classList.add('qhp__option--correct');
                    if(badge) badge.textContent = '✓';
                  } else if(i === selected){
                    b.classList.add('qhp__option--wrong');
                    if(badge) badge.textContent = '✕';
                  }
                }
              });
            }

            function renderFeedback(){
              var q = questions[idx];
              var isCorrect = selected === q.correct;

              feedbackTitle.textContent = isCorrect ? 'Correct! 🎉' : 'Not quite, but great try!';
              feedbackText.textContent = q.explanation || '';
              feedback.classList.add('is-visible');
            }

            function renderQuestion(){
              var q = questions[idx];
              qText.textContent = q.question;

              clearOptions();
              q.options.forEach(function(opt, i){
                optionsWrap.appendChild(makeOptionBtn(opt, i));
              });

              feedback.classList.remove('is-visible');
              nextBtn.classList.remove('is-visible');
              showFeedback = false;
              selected = null;
              updateProgress();
            }

            function getResultBucket(pct){
              if(pct >= 90){
                return { title: {{ section.settings.tier1_title | json }}, message: {{ section.settings.tier1_message | json }}, cta: {{ section.settings.tier1_cta | json }} };
              }
              if(pct >= 75){
                return { title: {{ section.settings.tier2_title | json }}, message: {{ section.settings.tier2_message | json }}, cta: {{ section.settings.tier2_cta | json }} };
              }
              if(pct >= 60){
                return { title: {{ section.settings.tier3_title | json }}, message: {{ section.settings.tier3_message | json }}, cta: {{ section.settings.tier3_cta | json }} };
              }
              return { title: {{ section.settings.tier4_title | json }}, message: {{ section.settings.tier4_message | json }}, cta: {{ section.settings.tier4_cta | json }} };
            }

            function showResults(){
              var total = questions.length;
              var pct = total ? Math.round((score / total) * 100) : 0;
              var bucket = getResultBucket(pct);

              resTitle.textContent = bucket.title || 'Your Results';
              resScore.textContent = score + '/' + total;
              resPct.textContent = pct + '% Correct';

              resMsg.textContent = bucket.message || '';
              resCta.textContent = bucket.cta || '';

              quizWrap.style.display = 'none';
              resultsWrap.style.display = '';
              resultsWrap.classList.add('is-visible');

              if(sendEnabled && sendMode === 'auto' && !sent){
                submitResults();
              }
            }

            function render(){
              if(!questions.length){
                qText.textContent = 'No quiz questions found. Please add question blocks.';
                clearOptions();
                return;
              }
              renderQuestion();
            }

            function onNext(){
              if(!showFeedback) return;

              if(idx < questions.length - 1){
                idx++;
                renderQuestion();
              } else {
                showResults();
              }
            }

            function validateLead(){
              var name = (leadNameInput && leadNameInput.value || '').trim();
              var email = (leadEmailInput && leadEmailInput.value || '').trim();

              var ok = name.length > 1 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
              if(!ok){
                if(leadError){
                  leadError.textContent = msgLeadRequired || 'Please enter your name and a valid email to begin.';
                  leadError.classList.add('is-visible');
                }
                return null;
              }
              if(leadError){
                leadError.textContent = '';
                leadError.classList.remove('is-visible');
              }
              return { name: name, email: email };
            }

            function startQuiz(){
              if(!leadEnabled){
                started = true;
                root.classList.add('qhp--started');
                resetQuizStateOnly();
                return;
              }

              var v = validateLead();
              if(!v) return;

              lead = v;
              started = true;
              root.classList.add('qhp--started');
              resetQuizStateOnly();
            }

            async function submitResults(){
              if(!sendEnabled) return;
              if(sent) return;

              if(submitForm){
                var hp = submitForm.querySelector('input[name="contact[company]"]');
                if(hp && hp.value) return;
              }

              if(leadEnabled && (!lead.email || !lead.name)){
                var v = validateLead();
                if(!v) return;
                lead = v;
              }

              if(sendBtn) sendBtn.disabled = true;
              if(sendStatus) sendStatus.textContent = 'Sending results…';

              var total = questions.length;
              var pct = total ? Math.round((score / total) * 100) : 0;
              var bucket = getResultBucket(pct);

              var breakdown = correctByQ.map(function(isCorrect, i){
                return 'Q' + (i+1) + ': ' + (isCorrect ? 'Correct' : 'Incorrect');
              }).join('\n');

              var body =
                'Quiz Results Submission\n' +
                '-----------------------\n' +
                'Name: ' + (lead.name || '') + '\n' +
                'Email: ' + (lead.email || '') + '\n' +
                'Score: ' + score + '/' + total + ' (' + pct + '%)\n' +
                'Result Tier: ' + (bucket.title || '') + '\n' +
                'Page URL: ' + window.location.href + '\n' +
                '\nBreakdown:\n' + breakdown + '\n' +
                '\nMessage:\n' + (bucket.message || '') + '\n' +
                '\nCTA:\n' + (bucket.cta || '') + '\n';

              try{
                if(formName) formName.value = lead.name || 'Quiz Participant';
                if(formEmail) formEmail.value = lead.email || '';
                if(formBody) formBody.value = body;

                var fd = new FormData(submitForm);
                var payload = new URLSearchParams();
                fd.forEach(function(v,k){ payload.append(k, v); });

                var resp = await fetch('/contact', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                  body: payload.toString()
                });

                if(resp && (resp.ok || resp.status === 200)){
                  sent = true;
                  if(sendStatus) sendStatus.textContent = msgSendSuccess || 'Sent! Our team received your quiz results.';
                } else {
                  if(sendBtn) sendBtn.disabled = false;
                  if(sendStatus) sendStatus.textContent = msgSendError || 'Sorry, we could not send your results. Please try again.';
                }
              } catch(err){
                if(sendBtn) sendBtn.disabled = false;
                if(sendStatus) sendStatus.textContent = msgSendError || 'Sorry, we could not send your results. Please try again.';
              }
            }

            // Bindings
            openBtns.forEach(function(btn){ btn.addEventListener('click', openModal); });
            closeBtn.addEventListener('click', closeModal);
            backdrop.addEventListener('click', closeModal);
            nextBtn.addEventListener('click', onNext);

            if(leadStartBtn) leadStartBtn.addEventListener('click', startQuiz);
            if(sendBtn) sendBtn.addEventListener('click', submitResults);

            retakeBtn && retakeBtn.addEventListener('click', function(){
              resetQuizStateOnly();
              quizWrap.style.display = '';
              resultsWrap.style.display = 'none';
              resultsWrap.classList.remove('is-visible');
            });

            document.addEventListener('keydown', function(e){
              if(!root.classList.contains('qhp--open')) return;
              if(e.key === 'Escape') closeModal();
            });

            // initial
            render();
          })();
        </script>
      </div>
    </div>
  </div>
</section>

