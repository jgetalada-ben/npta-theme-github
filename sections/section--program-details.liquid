{%- assign total_sections = 10 -%}
{%- assign show_curriculum = false -%}
{%- for i in (1..total_sections) -%}
  {%- assign title_key = i | append: "_curriculum_title" -%}
  {%- assign desc_key  = i | append: "_curriculum_description" -%}
  {%- if product.metafields.custom[title_key] != blank and product.metafields.custom[desc_key] != blank -%}
    {%- assign show_curriculum = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<section
  class="section--program-details{% if section.settings.enable_fadeup %} enable-fadeup{% endif %}"
  id="{{ section.settings.section_id }}"
  data-pd-section
>
  <div class="program-details-container page-container">

    <div class="details-column-left{% if section.settings.enable_fadeup %} pd-fadeup{% endif %}">
      <div class="section--title-block">
        <h2 class="is--flex-start program-details-h2">Program details</h2>
      </div>

      {% if product.metafields.custom._program_details %}
        <div class="program-details">
          {{ product.metafields.custom._program_details | metafield_tag }}
        </div>
      {% endif %}
    </div>

    <div class="details-column-right{% if section.settings.enable_fadeup %} pd-fadeup{% endif %}">
      {% if show_curriculum %}
        <div class="curriculum-card">
          <div class="section--title-block curriculum-card__title">
            <h2 class="is--flex-start">Curriculum</h2>
          </div>

          <div class="curriculum curriculum-card__body">
            <div class="curriculum-sections">
              {% for i in (1..total_sections) %}
                {% assign section_title_key = i | append: "_curriculum_title" %}
                {% assign long_desc_key = i | append: "_curriculum_description" %}
                {% assign section_title = product.metafields.custom[section_title_key] %}
                {% assign long_desc = product.metafields.custom[long_desc_key] %}

                {% if section_title != blank and long_desc != blank %}
                  <div class="curriculum-section">
                    <div class="section-header" data-target="#section{{ i }}">
                      <div class="section-header__text">
                        {{ section_title | metafield_tag }}
                      </div>

                      <button type="button" data-toggle="collapse" data-target="#section{{ i }}" aria-label="Toggle section">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                          <path d="M14.5625 18.3125C14.6875 18.4375 14.8333 18.5 15 18.5C15.1667 18.5 15.3125 18.4375 15.4375 18.3125L18.9375 14.8125C19.1458 14.6042 19.1979 14.375 19.0938 14.125C18.9896 13.875 18.7917 13.75 18.5 13.75H11.5C11.2083 13.75 11.0104 13.875 10.9063 14.125C10.8021 14.375 10.8542 14.6042 11.0625 14.8125L14.5625 18.3125Z" fill="#0F828C"/>
                          <path d="M15 27.5C13.2708 27.5 11.6458 27.1717 10.125 26.515C8.60417 25.8583 7.28125 24.9679 6.15625 23.8438C5.03125 22.7196 4.14084 21.3967 3.485 19.875C2.82917 18.3533 2.50083 16.7283 2.5 15C2.49917 13.2717 2.8275 11.6467 3.485 10.125C4.1425 8.60333 5.03292 7.28042 6.15625 6.15625C7.27958 5.03208 8.6025 4.14167 10.125 3.485C11.6475 2.82833 13.2725 2.5 15 2.5C16.7275 2.5 18.3525 2.82833 19.875 3.485C21.3975 4.14167 22.7204 5.03208 23.8438 6.15625C24.9671 7.28042 25.8579 8.60333 26.5163 10.125C27.1746 11.6467 27.5025 13.2717 27.5 15C27.4975 16.7283 27.1692 18.3533 26.515 19.875C25.8608 21.3967 24.9704 22.7196 23.8438 23.8438C22.7171 24.9679 21.3942 25.8587 19.875 26.5162C18.3558 27.1737 16.7308 27.5017 15 27.5Z" fill="#0F828C"/>
                        </svg>
                      </button>
                    </div>

                    <div id="section{{ i }}" class="section-body">
                      {{ long_desc | metafield_tag }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
@media only screen and (min-width: 981px) {
  .program-details-container { gap: 70px; }
  .details-column-left { width: 50%; }
  .details-column-right { width: 60%; max-width: 650px; background: transparent; padding: 0; border-radius: 0; }
}
@media only screen and (max-width: 980px) {
  .program-details-container { gap: 50px; flex-wrap: wrap; }
  .details-column-left { width: 100%; }
  .details-column-right { width: 100%; max-width: 100%; }
}
.section--program-details{ padding-top:70px; padding-bottom:70px; }

.program-details-container { display:flex; justify-content:space-between; gap:70px; }
.program-details-h2{ margin-top:0; }

.section--title-block h2 {
  color:#141414;
  font-family:'Anton', var(--font-heading-family, var(--font-body-family));
  font-size:42px;
  font-weight:500;
  letter-spacing:2px;
  line-height:112%;
  text-transform:uppercase;
}

.curriculum-card{
  background:#F8F8F8;
  border-radius:10px;
  padding:22px 22px 10px;
}
.curriculum-card__title{ margin-bottom:6px; }
.curriculum-card__title h2{ margin:0; text-align:left; }
.curriculum-card__body{ margin:0; }
.curriculum{ margin:0; }
.curriculum-sections{ margin-top:10px; }

.curriculum-section:first-child { border-bottom:2px solid #0F828C; }
.curriculum-section { border-bottom:2px solid #B3B9B9; }

.curriculum-sections .section-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:16px;
  cursor:pointer;
  padding:16px 0;
}
.curriculum-sections .section-header__text{ flex:1; min-width:0; }
.section-header .metafield-rich_text_field p{ margin:0; }
.section-header .metafield-rich_text_field p strong{ display:block; margin-bottom:6px; }

.curriculum-sections .section-header button{ background:transparent; border:none; outline:none; }
.curriculum-sections .section-header button svg{ width:24px; height:24px; vertical-align:middle; }

.curriculum-sections .section-body{
  max-height:0;
  overflow:hidden;
  transition:max-height .5s ease-out, padding .5s ease-out;
}
.section-body.collapse{
  max-height:2000px;
  padding:0 0 10px 0;
}

/* ✅ Fade-up (SAFE) 
   - Only hides when JS adds .js-fadeup
   - If JS fails, content remains visible
*/
.pd-fadeup{
  opacity: 1;
  transform: none;
}

.section--program-details.enable-fadeup.js-fadeup .pd-fadeup{
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 600ms ease, transform 600ms cubic-bezier(.2,.8,.2,1);
  will-change: opacity, transform;
}
.section--program-details.enable-fadeup.js-fadeup.is-inview .pd-fadeup{
  opacity: 1;
  transform: translateY(0);
}
@media (prefers-reduced-motion: reduce){
  .section--program-details.enable-fadeup.js-fadeup .pd-fadeup{
    opacity:1 !important;
    transform:none !important;
    transition:none !important;
  }
}
</style>

<script>
(function(){
  var wrapper = document.getElementById('shopify-section-{{ section.id }}');
  if (!wrapper) return;

  var root = wrapper.querySelector('.section--program-details');
  if (!root) return;

  // ---- Accordion (scoped + no global listeners) ----
  var plusSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none"><path d="M14.5625 18.3125C14.6875 18.4375 14.8333 18.5 15 18.5C15.1667 18.5 15.3125 18.4375 15.4375 18.3125L18.9375 14.8125C19.1458 14.6042 19.1979 14.375 19.0938 14.125C18.9896 13.875 18.7917 13.75 18.5 13.75H11.5C11.2083 13.75 11.0104 13.875 10.9063 14.125C10.8021 14.375 10.8542 14.6042 11.0625 14.8125L14.5625 18.3125ZM15 27.5C13.2708 27.5 11.6458 27.1717 10.125 26.515C8.60417 25.8583 7.28125 24.9679 6.15625 23.8438C5.03125 22.7196 4.14084 21.3967 3.485 19.875C2.82917 18.3533 2.50083 16.7283 2.5 15C2.49917 13.2717 2.8275 11.6467 3.485 10.125C4.1425 8.60333 5.03292 7.28042 6.15625 6.15625C7.27958 5.03208 8.6025 4.14167 10.125 3.485C11.6475 2.82833 13.2725 2.5 15 2.5C16.7275 2.5 18.3525 2.82833 19.875 3.485C21.3975 4.14167 22.7204 5.03208 23.8438 6.15625C24.9671 7.28042 25.8579 8.60333 26.5163 10.125C27.1746 11.6467 27.5025 13.2717 27.5 15C27.4975 16.7283 27.1692 18.3533 26.515 19.875C25.8608 21.3967 24.9704 22.7196 23.8438 23.8438C22.7171 24.9679 21.3942 25.8587 19.875 26.5162C18.3558 27.1737 16.7308 27.5017 15 27.5Z" fill="#0F828C"/></svg>';
  var minusSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none"><path d="M11.6875 15.4375C11.5625 15.3125 11.5 15.1667 11.5 15C11.5 14.8333 11.5625 14.6875 11.6875 14.5625L15.1875 11.0625C15.3958 10.8542 15.625 10.8021 15.875 10.9063C16.125 11.0104 16.25 11.2083 16.25 11.5L16.25 18.5C16.25 18.7917 16.125 18.9896 15.875 19.0937C15.625 19.1979 15.3958 19.1458 15.1875 18.9375L11.6875 15.4375ZM2.5 15C2.5 16.7292 2.82833 18.3542 3.485 19.875C4.14167 21.3958 5.03208 22.7187 6.15625 23.8437C7.28042 24.9687 8.60333 25.8592 10.125 26.515C11.6467 27.1708 13.2717 27.4992 15 27.5C16.7283 27.5008 18.3533 27.1725 19.875 26.515C21.3967 25.8575 22.7196 24.9671 23.8437 23.8437C24.9679 22.7204 25.8583 21.3975 26.515 19.875C27.1717 18.3525 27.5 16.7275 27.5 15C27.5 13.2725 27.1717 11.6475 26.515 10.125C25.8583 8.6025 24.9679 7.27958 23.8437 6.15625C22.7196 5.03291 21.3967 4.14208 19.875 3.48375C18.3533 2.82541 16.7283 2.4975 15 2.5C13.2717 2.5025 11.6467 2.83083 10.125 3.485C8.60333 4.13916 7.28042 5.02958 6.15625 6.15625C5.03208 7.28291 4.14125 8.60583 3.48375 10.125C2.82625 11.6442 2.49833 13.2692 2.5 15Z" fill="#0F828C"/></svg>';

  root.addEventListener('click', function(e){
    var header = e.target.closest('.section-header');
    if (!header || !root.contains(header)) return;

    var target = header.getAttribute('data-target');
    if (!target) return;

    var body = root.querySelector(target);
    if (!body) return;

    var btn = header.querySelector('button');

    if (body.classList.contains('collapse')) {
      body.classList.remove('collapse');
      if (btn) btn.innerHTML = plusSvg;
      return;
    }

    // close others
    root.querySelectorAll('.section-body.collapse').forEach(function(openBody){
      openBody.classList.remove('collapse');
      var h = openBody.previousElementSibling;
      if (h) {
        var b = h.querySelector('button');
        if (b) b.innerHTML = plusSvg;
      }
    });

    body.classList.add('collapse');
    if (btn) btn.innerHTML = minusSvg;
  });

  // ---- Fade-up (only if enabled) ----
  var enableFade = {{ section.settings.enable_fadeup | json }};
  if (enableFade) {
    root.classList.add('js-fadeup');

    var items = root.querySelectorAll('.pd-fadeup');
    if (items.length) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (!entry.isIntersecting) return;
          root.classList.add('is-inview');
          io.disconnect();
        });
      }, { threshold: 0.18 });

      io.observe(root);
    }
  }
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "certified-trainers" },
    { "type": "header", "content": "Program Details" },
    { "type": "paragraph", "content": "Configure the rich text content for the program details." },
    { "type": "richtext", "id": "program_details", "label": "Program Details", "default": "<p> Lorem ipsum dolor sit amet</p>", "info": "Enter the rich text content for the program details." },
    { "type": "checkbox", "id": "enable_fadeup", "label": "Enable fade-up animation on scroll", "default": false }
  ],
  "presets": [{ "name": "Default", "category": "Product" }]
}
{% endschema %}