{% schema %}
{
  "name": "Hero Banner Two",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline Text",
      "default": "GET CERTIFIED. BECOME A ______ COACH."
    },
    {
      "type": "richtext",
      "id": "desc1",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "desc_size",
      "label": "Description font-size (accepts clamp())",
      "default": "16px"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "BEST PRICE GUARANTEED"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "10,000+ NASM CERTIFICATIONS"
    },

    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 Text",
      "default": "CHOOSE MY PROGRAM"
    },
    {
      "type": "select",
      "id": "button_1_behavior",
      "label": "Button 1 behavior",
      "default": "new_tab",
      "options": [
        { "value": "same_tab", "label": "Open link (same tab)" },
        { "value": "new_tab", "label": "Open link (new tab)" },
        { "value": "popup_iframe", "label": "Open in popup (iframe)" }
      ]
    },
    {
      "type": "text",
      "id": "button_1_popup_url",
      "label": "Button 1 popup URL (iframe src)",
      "info": "Used only if behavior is Popup."
    },
    {
      "type": "text",
      "id": "button_1_popup_title",
      "label": "Button 1 popup title (accessibility)",
      "default": "Popup"
    },

    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 Text",
      "default": "TAKE THE QUIZ"
    },
    {
      "type": "select",
      "id": "button_2_behavior",
      "label": "Button 2 behavior",
      "default": "new_tab",
      "options": [
        { "value": "same_tab", "label": "Open link (same tab)" },
        { "value": "new_tab", "label": "Open link (new tab)" },
        { "value": "popup_iframe", "label": "Open in popup (iframe)" }
      ]
    },
    {
      "type": "text",
      "id": "button_2_popup_url",
      "label": "Button 2 popup URL (iframe src)",
      "info": "Used only if behavior is Popup."
    },
    {
      "type": "text",
      "id": "button_2_popup_title",
      "label": "Button 2 popup title (accessibility)",
      "default": "Popup"
    },

    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_image_width",
      "label": "Hero Image Width",
      "default": "500"
    },
    {
      "type": "text",
      "id": "hero_image_height",
      "label": "Hero Image Height",
      "default": "500"
    },
    {
      "type": "richtext",
      "id": "award_text",
      "label": "Award Text",
      "default": "<p>CANADA'S TOP FITNESS TRAINER<br>According to Impact Magazine</p>"
    },
    {
      "type": "richtext",
      "id": "award_sub_text",
      "label": "Award Sub Text",
      "default": "<p>According to Impact Magazine</p>"
    },
    {
      "type": "image_picker",
      "id": "award_image_1",
      "label": "Award Image"
    },
    {
      "type": "image_picker",
      "id": "award_image_2",
      "label": "Award Image"
    },
    {
      "type": "text",
      "id": "award_image_width",
      "label": "Award Image Width",
      "default": "40"
    },
    {
      "type": "text",
      "id": "award_image_height",
      "label": "Award Image Height",
      "default": "40"
    },
    {
      "type": "text",
      "id": "partner_text",
      "label": "Partner Text",
      "default": "OFFICIAL CANADIAN PARTNER"
    },
    {
      "type": "image_picker",
      "id": "partner_image",
      "label": "Partner Logo"
    },
    {
      "type": "text",
      "id": "partner_image_width",
      "label": "Partner Image Width",
      "default": "40"
    },
    {
      "type": "text",
      "id": "partner_image_height",
      "label": "Partner Image Height",
      "default": "40"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "word_text",
          "label": "Word Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Two"
    }
  ]
}
{% endschema %}

{%- assign sid = section.id -%}
{%- assign modal_id_1 = 'hb2Modal1-' | append: sid -%}
{%- assign modal_id_2 = 'hb2Modal2-' | append: sid -%}

{%- assign btn1_is_popup = false -%}
{%- if section.settings.button_1_behavior == 'popup_iframe' and section.settings.button_1_popup_url != blank -%}
  {%- assign btn1_is_popup = true -%}
{%- endif -%}

{%- assign btn2_is_popup = false -%}
{%- if section.settings.button_2_behavior == 'popup_iframe' and section.settings.button_2_popup_url != blank -%}
  {%- assign btn2_is_popup = true -%}
{%- endif -%}

<section class="section--hero-banner" data-hb2-root="{{ sid }}">
  {% if section.settings.partner_text != blank %}
    <div class="partner partner-mobile">
      <p>{{ section.settings.partner_text }}</p>
      <img src="{{ section.settings.partner_image | img_url }}" alt="Partner Logo" width="{{ section.settings.partner_image_width }}" height="{{ section.settings.partner_image_height }}">
    </div>
  {% endif %}
  <div class="section--hero-content">

    <div class="section--hero-text">

      <div class="home-hero_heading-wrapper">
        <h1 class="home-hero_heading">
          <span class="hero-desktop">{{section.settings.headline}}</span>
          <span class="hero-mobile">{{section.settings.headline}}</span>
          <span class="home-hero__words"></span>
          {% comment %} <span class="home-hero__things-text">Coach.</span> {% endcomment %}
        </h1>
      </div>

      <div class="home-hero__words-container" style="display:none;">
        {% for block in section.blocks %}
          <span class="home-hero__word">{{ block.settings.word_text }}</span>
        {% endfor %}
      </div>

      {% if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank %}
      <div class="section--hero-badges">
        {% if section.settings.badge_1_text != blank %}
          <div class="section--badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M16.1371 4.728L17.9671 6.558C20.6561 9.248 22.0001 10.592 22.0001 12.262C22.0001 13.933 20.6561 15.277 17.9671 17.966C15.2771 20.656 13.9331 22 12.2621 22C10.5921 22 9.24711 20.656 6.55811 17.967L4.72811 16.137C3.18311 14.591 2.41011 13.819 2.12311 12.816C1.83511 11.813 2.08111 10.748 2.57311 8.619L2.85611 7.391C3.26911 5.599 3.47611 4.703 4.08911 4.089C4.70311 3.476 5.59911 3.269 7.39111 2.856L8.61911 2.572C10.7491 2.081 11.8131 1.835 12.8161 2.122C13.8191 2.41 14.5921 3.183 16.1371 4.728Z" fill="#C1FF72" />
            </svg>
            <span>{{ section.settings.badge_1_text }}</span>
          </div>
        {% endif %}
        {% if section.settings.badge_2_text != blank %}
          <div class="section--badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.586 2.1C10.94 1.74648 11.4136 1.53846 11.9134 1.51698C12.4132 1.49551 12.903 1.66214 13.286 1.984L13.414 2.101L15.314 4H18C18.5044 4.00009 18.9901 4.19077 19.3599 4.53384C19.7297 4.8769 19.9561 5.34702 19.994 5.85L20 6V8.686L21.9 10.586C22.2538 10.94 22.462 11.4139 22.4834 11.9139C22.5049 12.414 22.3381 12.9039 22.016 13.287L21.899 13.414L19.999 15.314V18C19.9991 18.5046 19.8086 18.9906 19.4655 19.3605C19.1224 19.7305 18.6521 19.9572 18.149 19.995L18 20H15.315L13.415 21.9C13.0609 22.2538 12.5871 22.462 12.087 22.4835C11.587 22.505 11.097 22.3382 10.714 22.016L10.587 21.9Z" fill="#C1FF72" />
            </svg>
            <span>{{ section.settings.badge_2_text }}</span>
          </div>
        {% endif %}
      </div>
      {% endif %}

      {% if section.settings.desc1 != blank %}
        <div class="top-banner-desc" style="font-size: {{ section.settings.desc_size | default: '16px' }};">
          {{ section.settings.desc1 }}
        </div>
      {% endif %}

      <div class="section--hero-buttons">
        {% if section.settings.button_1_text != blank %}
          {%- assign b1_target = '' -%}
          {%- if section.settings.button_1_behavior == 'new_tab' -%}{%- assign b1_target = '_blank' -%}{%- endif -%}

          <a
            {% if btn1_is_popup %}
              href="#"
              class="btn button-yg hb2-open"
              data-hb2-open="{{ modal_id_1 }}"
              data-hb2-src="{{ section.settings.button_1_popup_url | escape }}"
              aria-haspopup="dialog"
              aria-controls="{{ modal_id_1 }}"
            {% else %}
              href="{{ section.settings.button_1_link }}"
              class="btn button-yg"
              {% if b1_target != blank %}target="{{ b1_target }}"{% endif %}
              {% if b1_target == '_blank' %}rel="noopener noreferrer"{% endif %}
            {% endif %}
          >
            <span class="btn-label-down">{{ section.settings.button_1_text }}</span>
            <span class="btn-label-down">{{ section.settings.button_1_text }}</span>
          </a>
        {% endif %}

        {% if section.settings.button_2_text != blank %}
          {%- assign b2_target = '' -%}
          {%- if section.settings.button_2_behavior == 'new_tab' -%}{%- assign b2_target = '_blank' -%}{%- endif -%}

          <a
            {% if btn2_is_popup %}
              href="#"
              class="btn button-w hb2-open"
              data-hb2-open="{{ modal_id_2 }}"
              data-hb2-src="{{ section.settings.button_2_popup_url | escape }}"
              aria-haspopup="dialog"
              aria-controls="{{ modal_id_2 }}"
            {% else %}
              href="{{ section.settings.button_2_link }}"
              class="btn button-w"
              {% if b2_target != blank %}target="{{ b2_target }}"{% endif %}
              {% if b2_target == '_blank' %}rel="noopener noreferrer"{% endif %}
            {% endif %}
          >
            <span class="btn-label-down">{{ section.settings.button_2_text }}</span>
            <span class="btn-label-down">{{ section.settings.button_2_text }}</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.award_text != blank or section.settings.award_sub_text != blank or section.settings.partner_text != blank %}
      <div class="section--hero-footer">

        {% if section.settings.award_text != blank and section.settings.award_sub_text != blank %}
          <div class="award">
            <div class="award-badge-desktop">
              <img src="{{ section.settings.award_image_1 | img_url }}" alt="Award Icon" width="{{ section.settings.award_image_width }}" height="{{ section.settings.award_image_height }}">
              <img src="{{ section.settings.award_image_2 | img_url }}" alt="Award Icon" width="{{ section.settings.award_image_width }}" height="{{ section.settings.award_image_height }}">
            </div>
            <div class="award-badge-mobile">
              <!-- keep your svg -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="42" viewBox="0 0 32 42" fill="none">
                <path d="M14.53 0.940381C15.418 0.355811 16.5805 0.355811 17.4686 0.940381L18.9055 1.8773C19.3899 2.1896 19.955 2.34175 20.5282 2.30972L22.2477 2.20562C23.3134 2.14155 24.3144 2.71812 24.7907 3.66304Z" fill="#C1FF72" />
              </svg>
            </div>
            <div class="award-text">
              {{ section.settings.award_text }}
              <div class="award-sub-text">
                {{ section.settings.award_sub_text }}
              </div>
            </div>
          </div>
        {% endif %}

        {% if section.settings.partner_text != blank %}
          <div class="partner partner-desktop">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
              <path d="M1.826 11.801 1 12.156s4.844 4.214 4.966 4.33Z" fill="#C1FF72" />
            </svg>
            <span>{{ section.settings.partner_text }}</span>
            <img src="{{ section.settings.partner_image | img_url }}" alt="Partner Logo" width="{{ section.settings.partner_image_width }}" height="{{ section.settings.partner_image_height }}">
          </div>
        {% endif %}
      </div>
      {% endif %}

    </div>
  </div>

  <!-- KEEP THIS EXACTLY (this is your background image) -->
  <div class="section--hero-background" style="background-image: url({{ section.settings.background_image | img_url: 'original' }});"></div>

  {%- if btn1_is_popup -%}
    <div id="{{ modal_id_1 }}" class="hb2-modal" role="dialog" aria-modal="true" aria-label="{{ section.settings.button_1_popup_title | escape }}" hidden>
      <div class="hb2-modal__overlay" data-hb2-close></div>
      <div class="hb2-modal__panel" role="document">
        <button type="button" class="hb2-modal__close" aria-label="Close popup" data-hb2-close>&times;</button>
        <iframe class="hb2-modal__iframe" title="{{ section.settings.button_1_popup_title | escape }}" loading="lazy"></iframe>
      </div>
    </div>
  {%- endif -%}

  {%- if btn2_is_popup -%}
    <div id="{{ modal_id_2 }}" class="hb2-modal" role="dialog" aria-modal="true" aria-label="{{ section.settings.button_2_popup_title | escape }}" hidden>
      <div class="hb2-modal__overlay" data-hb2-close></div>
      <div class="hb2-modal__panel" role="document">
        <button type="button" class="hb2-modal__close" aria-label="Close popup" data-hb2-close>&times;</button>
        <iframe class="hb2-modal__iframe" title="{{ section.settings.button_2_popup_title | escape }}" loading="lazy"></iframe>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  /* ===== your existing CSS stays the same ===== */
  /* (I did NOT touch your existing CSS blocks — keep them below as-is) */

  /* ===== Popup modal CSS (added) ===== */
  .hb2-modal[hidden]{ display:none !important; }
  .hb2-modal{
    position: fixed;
    inset: 0;
    z-index: 999999;
  }
  .hb2-modal__overlay{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.6);
  }
  .hb2-modal__panel{
    position: relative;
    width: min(980px, calc(100vw - 24px));
    height: min(80vh, 760px);
    margin: 6vh auto 0;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
  }
  .hb2-modal__close{
    position: absolute;
    top: 10px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: rgba(0,0,0,.08);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }
  .hb2-modal__iframe{
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (max-width: 749px){
    .hb2-modal__panel{
      height: 78vh;
      margin-top: 8vh;
    }
  }
</style>

<!-- ✅ REPLACE your old jQuery word script with this vanilla JS script -->
<script>
(function(){
  var root = document.querySelector('.section--hero-banner[data-hb2-root="{{ sid }}"]');
  if(!root) return;

  /* ========= POPUP (safe for multiple sections) ========= */
  function openModal(modalId, src){
    var modal = document.getElementById(modalId);
    if(!modal) return;

    var iframe = modal.querySelector('.hb2-modal__iframe');
    if(iframe) iframe.src = src || '';

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    var closeBtn = modal.querySelector('[data-hb2-close]');
    if(closeBtn) closeBtn.focus();
  }

  function closeModal(modal){
    if(!modal) return;

    var iframe = modal.querySelector('.hb2-modal__iframe');
    if(iframe) iframe.src = 'about:blank';

    modal.hidden = true;
    document.body.style.overflow = '';
  }

  root.addEventListener('click', function(e){
    var btn = e.target.closest('.hb2-open');
    if(!btn) return;
    e.preventDefault();

    openModal(btn.getAttribute('data-hb2-open'), btn.getAttribute('data-hb2-src') || '');
  });

  document.addEventListener('click', function(e){
    var closer = e.target.closest('[data-hb2-close]');
    if(!closer) return;

    var modal = closer.closest('.hb2-modal');
    if(modal) closeModal(modal);
  });

  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;

    var m1 = document.getElementById('{{ modal_id_1 }}');
    var m2 = document.getElementById('{{ modal_id_2 }}');
    if(m1 && !m1.hidden) closeModal(m1);
    if(m2 && !m2.hidden) closeModal(m2);
  });

  /* ========= WORD ROTATOR (NO jQuery so it won't break) ========= */
  var wordEls = root.querySelectorAll('.home-hero__word');
  var wordContainer = root.querySelector('.home-hero__words');
  if(!wordEls.length || !wordContainer) return;

  var words = Array.prototype.slice.call(wordEls).map(function(el){ return (el.textContent || '').trim(); }).filter(Boolean);
  var currentIndex = 0;
  var delay = 100;
  var extraStay = 1000;
  var interval = null;

  function isMobile(){
    return window.matchMedia && window.matchMedia("(max-width: 768px)").matches;
  }

  function splitWordToLetters(word){
    return word.split("").map(function(letter){
      if(letter === " "){
        return '<em class="home-hero__letter space">&nbsp;</em>';
      }
      return '<em class="home-hero__letter">' + letter.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</em>';
    }).join("");
  }

  function showWord(index){
    var word = words[index] || '';
    if(isMobile()){
      wordContainer.innerHTML = '<span class="home-hero__word-animate">' + word.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</span>';
    } else {
      wordContainer.innerHTML = splitWordToLetters(word);
    }
  }

  function animateLettersIn(){
    var letters = root.querySelectorAll('.home-hero__letter');
    letters.forEach(function(el, i){
      setTimeout(function(){ el.classList.add('active'); }, i * delay);
    });
  }

  function animateWordsIn(){
    var el = root.querySelector('.home-hero__word-animate');
    if(el) el.classList.add('active');
  }

  function animateLettersOut(done){
    var letters = root.querySelectorAll('.home-hero__letter');
    var total = (letters.length * delay) + 20;
    letters.forEach(function(el, i){
      setTimeout(function(){
        el.classList.remove('active');
        el.classList.add('exit');
      }, i * delay);
    });
    setTimeout(function(){ if(done) done(); }, total);
  }

  function animateWordsOut(done){
    var el = root.querySelector('.home-hero__word-animate');
    if(!el){ if(done) done(); return; }
    el.classList.remove('active');
    el.classList.add('exit');
    setTimeout(function(){ if(done) done(); }, 800);
  }

  function startAnimation(){
    if(interval) clearInterval(interval);

    showWord(currentIndex);

    if(isMobile()){
      animateWordsIn();
      interval = setInterval(function(){
        animateWordsOut(function(){
          currentIndex = (currentIndex + 1) % words.length;
          showWord(currentIndex);
          animateWordsIn();
        });
      }, 3000 + extraStay);
    } else {
      animateLettersIn();
      interval = setInterval(function(){
        animateLettersOut(function(){
          currentIndex = (currentIndex + 1) % words.length;
          showWord(currentIndex);
          animateLettersIn();
        });
      }, 3000 + extraStay);
    }
  }

  startAnimation();

  window.addEventListener("resize", function(){
    startAnimation();
  });
})();
</script>

