{% comment %}
  Section: Hero Banner Two
  Update:
  - Add "Button behavior" (same tab / new tab / popup iframe) for BOTH buttons
  - Safe when multiple sections with popups exist on the same page (scoped by section.id)
  - Fix the rotating word script: remove the jQuery dependency (your current code runs BEFORE jQuery loads)
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign modal_id_1 = 'hb2Modal1-' | append: sid -%}
{%- assign modal_id_2 = 'hb2Modal2-' | append: sid -%}

{% schema %}
{
  "name": "Hero Banner Two",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background Image" },

    { "type": "text", "id": "headline", "label": "Headline Text", "default": "GET CERTIFIED. BECOME A ______ COACH." },
    { "type": "richtext", "id": "desc1", "label": "Description" },
    { "type": "text", "id": "desc_size", "label": "Description font-size (accepts clamp())", "default": "16px" },

    { "type": "text", "id": "badge_1_text", "label": "Badge 1 Text", "default": "BEST PRICE GUARANTEED" },
    { "type": "text", "id": "badge_2_text", "label": "Badge 2 Text", "default": "10,000+ NASM CERTIFICATIONS" },

    { "type": "url", "id": "button_1_link", "label": "Button 1 Link" },
    { "type": "text", "id": "button_1_text", "label": "Button 1 Text", "default": "CHOOSE MY PROGRAM" },

    {
      "type": "select",
      "id": "button_1_behavior",
      "label": "Button 1 behavior",
      "default": "new_tab",
      "options": [
        { "value": "same_tab", "label": "Open link (same tab)" },
        { "value": "new_tab", "label": "Open link (new tab)" },
        { "value": "popup_iframe", "label": "Open in popup (iframe)" }
      ]
    },
    {
      "type": "text",
      "id": "button_1_popup_url",
      "label": "Button 1 popup URL (iframe src)",
      "info": "Used only if behavior is Popup."
    },
    { "type": "text", "id": "button_1_popup_title", "label": "Button 1 popup title (accessibility)", "default": "Popup" },

    { "type": "url", "id": "button_2_link", "label": "Button 2 Link" },
    { "type": "text", "id": "button_2_text", "label": "Button 2 Text", "default": "TAKE THE QUIZ" },

    {
      "type": "select",
      "id": "button_2_behavior",
      "label": "Button 2 behavior",
      "default": "new_tab",
      "options": [
        { "value": "same_tab", "label": "Open link (same tab)" },
        { "value": "new_tab", "label": "Open link (new tab)" },
        { "value": "popup_iframe", "label": "Open in popup (iframe)" }
      ]
    },
    {
      "type": "text",
      "id": "button_2_popup_url",
      "label": "Button 2 popup URL (iframe src)",
      "info": "Used only if behavior is Popup."
    },
    { "type": "text", "id": "button_2_popup_title", "label": "Button 2 popup title (accessibility)", "default": "Popup" },

    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_image_width", "label": "Hero Image Width", "default": "500" },
    { "type": "text", "id": "hero_image_height", "label": "Hero Image Height", "default": "500" },

    { "type": "richtext", "id": "award_text", "label": "Award Text", "default": "<p>CANADA'S TOP FITNESS TRAINER<br>According to Impact Magazine</p>" },
    { "type": "richtext", "id": "award_sub_text", "label": "Award Sub Text", "default": "<p>According to Impact Magazine</p>" },

    { "type": "image_picker", "id": "award_image_1", "label": "Award Image" },
    { "type": "image_picker", "id": "award_image_2", "label": "Award Image" },
    { "type": "text", "id": "award_image_width", "label": "Award Image Width", "default": "40" },
    { "type": "text", "id": "award_image_height", "label": "Award Image Height", "default": "40" },

    { "type": "text", "id": "partner_text", "label": "Partner Text", "default": "OFFICIAL CANADIAN PARTNER" },
    { "type": "image_picker", "id": "partner_image", "label": "Partner Logo" },
    { "type": "text", "id": "partner_image_width", "label": "Partner Image Width", "default": "40" },
    { "type": "text", "id": "partner_image_height", "label": "Partner Image Height", "default": "40" },

    { "type": "header", "content": "Rotating word settings" },
    { "type": "range", "id": "word_interval", "label": "Change word every (seconds)", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 3 },
    { "type": "range", "id": "word_letter_delay", "label": "Letter stagger delay (ms)", "min": 20, "max": 200, "step": 10, "unit": "ms", "default": 100 },
    { "type": "range", "id": "word_extra_stay", "label": "Extra stay time (ms)", "min": 0, "max": 3000, "step": 100, "unit": "ms", "default": 1000 },

    { "type": "header", "content": "Popup style (both buttons)" },
    { "type": "range", "id": "popup_max_width", "label": "Popup max width (px)", "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 980 },
    { "type": "text", "id": "popup_height_desktop", "label": "Popup height desktop (CSS)", "default": "min(80vh, 760px)" },
    { "type": "text", "id": "popup_height_mobile", "label": "Popup height mobile (CSS)", "default": "78vh" }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        { "type": "text", "id": "word_text", "label": "Word Text" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero Banner Two" }
  ]
}
{% endschema %}

{%- assign btn1_is_popup = false -%}
{%- if section.settings.button_1_behavior == 'popup_iframe' and section.settings.button_1_popup_url != blank -%}
  {%- assign btn1_is_popup = true -%}
{%- endif -%}

{%- assign btn2_is_popup = false -%}
{%- if section.settings.button_2_behavior == 'popup_iframe' and section.settings.button_2_popup_url != blank -%}
  {%- assign btn2_is_popup = true -%}
{%- endif -%}

<section id="HeroBannerTwo-{{ sid }}" class="section--hero-banner" data-hb2-root>
  {% if section.settings.partner_text != blank %}
    <div class="partner partner-mobile">
      <p>{{ section.settings.partner_text }}</p>
      {% if section.settings.partner_image != blank %}
        <img src="{{ section.settings.partner_image | img_url }}" alt="Partner Logo" width="{{ section.settings.partner_image_width }}" height="{{ section.settings.partner_image_height }}">
      {% endif %}
    </div>
  {% endif %}

  <div class="section--hero-content">
    <div class="section--hero-text">
      <div class="home-hero_heading-wrapper">
        <h1 class="home-hero_heading">
          <span class="hero-desktop">{{ section.settings.headline }}</span>
          <span class="hero-mobile">{{ section.settings.headline }}</span>
          <span class="home-hero__words" aria-live="polite"></span>
        </h1>
      </div>

      <div class="home-hero__words-container" style="display:none;">
        {% for block in section.blocks %}
          {% if block.type == 'word' and block.settings.word_text != blank %}
            <span class="home-hero__word">{{ block.settings.word_text }}</span>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank %}
        <div class="section--hero-badges">
          {% if section.settings.badge_1_text != blank %}
            <div class="section--badge">
              <!-- (SVG unchanged) -->
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16.1371 4.728L17.9671 6.558C20.6561 9.248 22.0001 10.592 22.0001 12.262C22.0001 13.933 20.6561 15.277 17.9671 17.966C15.2771 20.656 13.9331 22 12.2621 22C10.5921 22 9.24711 20.656 6.55811 17.967L4.72811 16.137C3.18311 14.591 2.41011 13.819 2.12311 12.816C1.83511 11.813 2.08111 10.748 2.57311 8.619L2.85611 7.391C3.26911 5.599 3.47611 4.703 4.08911 4.089C4.70311 3.476 5.59911 3.269 7.39111 2.856L8.61911 2.572C10.7491 2.081 11.8131 1.835 12.8161 2.122C13.8191 2.41 14.5921 3.183 16.1371 4.728Z" fill="#C1FF72" />
              </svg>
              <span>{{ section.settings.badge_1_text }}</span>
            </div>
          {% endif %}

          {% if section.settings.badge_2_text != blank %}
            <div class="section--badge">
              <!-- (SVG unchanged) -->
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.586 2.1C10.94 1.74648 11.4136 1.53846 11.9134 1.51698C12.4132 1.49551 12.903 1.66214 13.286 1.984L13.414 2.101L15.314 4H18C18.5044 4.00009 18.9901 4.19077 19.3599 4.53384C19.7297 4.8769 19.9561 5.34702 19.994 5.85L20 6V8.686L21.9 10.586C22.2538 10.94 22.462 11.4139 22.4834 11.9139C22.5049 12.414 22.3381 12.9039 22.016 13.287L21.899 13.414L19.999 15.314V18C19.9991 18.5046 19.8086 18.9906 19.4655 19.3605C19.1224 19.7305 18.6521 19.9572 18.149 19.995L18 20H15.315L13.415 21.9C13.0609 22.2538 12.5871 22.462 12.087 22.4835C11.587 22.505 11.097 22.3382 10.714 22.016L10.587 21.9L8.68697 20H5.99997C5.49539 20.0002 5.0094 19.8096 4.63942 19.4665C4.26944 19.1234 4.04281 18.6532 4.00497 18.15L3.99997 18V15.314L2.09997 13.414C1.74616 13.06 1.53797 12.5861 1.51649 12.0861C1.49502 11.586 1.66182 11.0961 1.98397 10.713L2.09997 10.586L3.99997 8.686V6C4.00006 5.4956 4.19074 5.00986 4.53381 4.64009C4.87687 4.27032 5.34699 4.04383 5.84997 4.006L5.99997 4H8.68597L10.586 2.1Z" fill="#C1FF72" />
              </svg>
              <span>{{ section.settings.badge_2_text }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.desc1 != blank %}
        <div class="top-banner-desc" style="font-size: {{ section.settings.desc_size | default: '16px' }};">
          {{ section.settings.desc1 }}
        </div>
      {% endif %}

      <div class="section--hero-buttons">
        {% if section.settings.button_1_text != blank %}
          {%- assign b1_target = '' -%}
          {%- if section.settings.button_1_behavior == 'new_tab' -%}{%- assign b1_target = '_blank' -%}{%- endif -%}

          <a
            {% if btn1_is_popup %}
              href="#"
              class="btn button-yg js-hb2-open"
              data-hb2-open="{{ modal_id_1 }}"
              data-hb2-src="{{ section.settings.button_1_popup_url | escape }}"
              aria-haspopup="dialog"
              aria-controls="{{ modal_id_1 }}"
            {% else %}
              href="{{ section.settings.button_1_link }}"
              class="btn button-yg"
              {% if b1_target != blank %}target="{{ b1_target }}"{% endif %}
              {% if b1_target == '_blank' %}rel="noopener noreferrer"{% endif %}
            {% endif %}
          >
            <span class="btn-label-down">{{ section.settings.button_1_text }}</span>
            <span class="btn-label-down">{{ section.settings.button_1_text }}</span>
          </a>
        {% endif %}

        {% if section.settings.button_2_text != blank %}
          {%- assign b2_target = '' -%}
          {%- if section.settings.button_2_behavior == 'new_tab' -%}{%- assign b2_target = '_blank' -%}{%- endif -%}

          <a
            {% if btn2_is_popup %}
              href="#"
              class="btn button-w js-hb2-open"
              data-hb2-open="{{ modal_id_2 }}"
              data-hb2-src="{{ section.settings.button_2_popup_url | escape }}"
              aria-haspopup="dialog"
              aria-controls="{{ modal_id_2 }}"
            {% else %}
              href="{{ section.settings.button_2_link }}"
              class="btn button-w"
              {% if b2_target != blank %}target="{{ b2_target }}"{% endif %}
              {% if b2_target == '_blank' %}rel="noopener noreferrer"{% endif %}
            {% endif %}
          >
            <span class="btn-label-down">{{ section.settings.button_2_text }}</span>
            <span class="btn-label-down">{{ section.settings.button_2_text }}</span>
          </a>
        {% endif %}
      </div>

      <!-- (rest of your footer/award/partner markup remains the same; keep as-is below) -->
      {% if section.settings.award_text != blank or section.settings.award_sub_text != blank or section.settings.partner_text != blank %}
        <div class="section--hero-footer">
          {% if section.settings.award_text != blank and section.settings.award_sub_text != blank %}
            <div class="award">
              <div class="award-badge-desktop">
                {% if section.settings.award_image_1 != blank %}
                  <img src="{{ section.settings.award_image_1 | img_url }}" alt="Award Icon" width="{{ section.settings.award_image_width }}" height="{{ section.settings.award_image_height }}">
                {% endif %}
                {% if section.settings.award_image_2 != blank %}
                  <img src="{{ section.settings.award_image_2 | img_url }}" alt="Award Icon" width="{{ section.settings.award_image_width }}" height="{{ section.settings.award_image_height }}">
                {% endif %}
              </div>
              <div class="award-badge-mobile">
                <!-- (mobile SVG unchanged) -->
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="42" viewBox="0 0 32 42" fill="none">
                  <path d="M14.53 0.940381C15.418 0.355811 16.5805 0.355811 17.4686 0.940381L18.9055 1.8773C19.3899 2.1896 19.955 2.34175 20.5282 2.30972L22.2477 2.20562C23.3134 2.14155 24.3144 2.71812 24.7907 3.66304L25.5657 5.19253C25.824 5.70503 26.2438 6.11343 26.7524 6.36968L28.3105 7.14644C29.2631 7.6189 29.8443 8.61187 29.7798 9.6689L29.6748 11.3746C29.6425 11.9431 29.7959 12.5117 30.1108 12.9841L31.0634 14.4095C31.6527 15.2904 31.6527 16.4435 31.0634 17.3244L30.1108 18.7578C29.7959 19.2382 29.6425 19.7988 29.6748 20.3673L29.7798 22.073C29.8443 23.13 29.2631 24.123 28.3105 24.5955L26.7686 25.3642C26.2519 25.6205 25.8402 26.0369 25.5818 26.5414L24.7988 28.0869C24.3225 29.0318 23.3214 29.6084 22.2558 29.5443L20.5363 29.4402C19.9631 29.4082 19.3899 29.5603 18.9136 29.8726L17.4766 30.8175C16.5886 31.4021 15.4261 31.4021 14.5381 30.8175L13.093 29.8726C12.6087 29.5603 12.0436 29.4082 11.4704 29.4402L9.75086 29.5443C8.68523 29.6084 7.68419 29.0318 7.20789 28.0869L6.43289 26.5574C6.17455 26.0449 5.75476 25.6365 5.24617 25.3802L3.6881 24.6035C2.73549 24.131 2.15424 23.138 2.21882 22.081L2.32377 20.3753C2.35606 19.8068 2.20268 19.2382 1.88783 18.7658L0.943303 17.3324C0.35398 16.4515 0.35398 15.2984 0.943303 14.4175L1.88783 12.9921C2.20268 12.5117 2.35606 11.9511 2.32377 11.3826L2.21882 9.6769C2.15424 8.61987 2.73549 7.6269 3.6881 7.15444L5.23002 6.38569C5.74669 6.12144 6.16648 5.70503 6.42481 5.19253L7.19981 3.66304C7.67612 2.71812 8.67716 2.14155 9.74278 2.20562L11.4623 2.30972C12.0355 2.34175 12.6087 2.1896 13.085 1.8773L14.53 0.940381Z" fill="#C1FF72"/>
                </svg>
              </div>

              <div class="award-text">
                {{ section.settings.award_text }}
                <div class="award-sub-text">{{ section.settings.award_sub_text }}</div>
              </div>
            </div>
          {% endif %}

          {% if section.settings.partner_text != blank %}
            <div class="partner partner-desktop">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                <path d="M1.826 11.801 1 12.156s4.844 4.214 4.966 4.33c.241.234.472.352.241 1.055-.241.703-.476 1.645-.476 1.645s4.495-.942 4.972-1.059c.411-.042.864.117.864.586 0 .473-.274 5.286-.274 5.286h1.416s-.274-4.813-.274-5.287c0-.469.448-.628.869-.586.472.117 4.966 1.059 4.966 1.059s-.236-.942-.472-1.645c-.237-.703 0-.82.236-1.055.118-.117 4.966-4.33 4.966-4.33l-.826-.352c-.472-.23-.349-.539-.236-.816.114-.356.949-3.155.949-3.155s-2.252.469-2.724.586c-.354.112-.472-.117-.59-.352s-.708-1.519-.708-1.519-2.484 2.808-2.602 2.92c-.472.352-.949 0-.831-.469 0-.469 1.303-6.074 1.303-6.074s-1.421.816-1.894 1.05c-.354.234-.595.234-.831-.234C13.77 3.389 11.994 0 11.994 0l.001.002s-1.771 3.389-2.006 3.741c-.236.468-.472.468-.831.233-.472-.234-1.894-1.05-1.894-1.05S8.567 8.531 8.567 9c.119.47-.354.821-.83.47-.118-.117-2.602-2.92-2.602-2.92s-.59 1.28-.708 1.514c-.117.234-.235.464-.59.352-.476-.117-2.724-.586-2.724-.586s.831 2.798.949 3.155c.113.281.235.586-.236.816Z" fill="#C1FF72"/>
              </svg>
              <span>{{ section.settings.partner_text }}</span>
              {% if section.settings.partner_image != blank %}
                <img src="{{ section.settings.partner_image | img_url }}" alt="Partner Logo" width="{{ section.settings.partner_image_width }}" height="{{ section.settings.partner_image_height }}">
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="section--hero-background" style="background-image: url({{ section.settings.background_image | img_url: 'original' }});"></div>

  {%- if btn1_is_popup -%}
    <div id="{{ modal_id_1 }}" class="hb2-modal" role="dialog" aria-modal="true" aria-label="{{ section.settings.button_1_popup_title | escape }}" hidden>
      <div class="hb2-modal__overlay" data-hb2-close></div>
      <div class="hb2-modal__panel" role="document">
        <button type="button" class="hb2-modal__close" aria-label="Close popup" data-hb2-close>&times;</button>
        <iframe class="hb2-modal__iframe" title="{{ section.settings.button_1_popup_title | escape }}" loading="lazy"></iframe>
      </div>
    </div>
  {%- endif -%}

  {%- if btn2_is_popup -%}
    <div id="{{ modal_id_2 }}" class="hb2-modal" role="dialog" aria-modal="true" aria-label="{{ section.settings.button_2_popup_title | escape }}" hidden>
      <div class="hb2-modal__overlay" data-hb2-close></div>
      <div class="hb2-modal__panel" role="document">
        <button type="button" class="hb2-modal__close" aria-label="Close popup" data-hb2-close>&times;</button>
        <iframe class="hb2-modal__iframe" title="{{ section.settings.button_2_popup_title | escape }}" loading="lazy"></iframe>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  /* ===== your existing styles stay the same (I kept your key animation styles) ===== */
  #HeroBannerTwo-{{ sid }} .home-hero__words { margin-bottom: -10px; }
  #HeroBannerTwo-{{ sid }} .home-hero__words em { font-style: normal !important; }

  #HeroBannerTwo-{{ sid }} .home-hero__letter,
  #HeroBannerTwo-{{ sid }} .home-hero__word-animate{
    display: inline-block;
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.8s ease, opacity 0.8s ease;
  }
  #HeroBannerTwo-{{ sid }} .home-hero__letter.active,
  #HeroBannerTwo-{{ sid }} .home-hero__word-animate.active{
    transform: translateY(0);
    opacity: 1;
  }
  #HeroBannerTwo-{{ sid }} .home-hero__letter.exit,
  #HeroBannerTwo-{{ sid }} .home-hero__word-animate.exit{
    transform: translateY(-120%);
    opacity: 0;
  }
  #HeroBannerTwo-{{ sid }} .home-hero__letter.space { width: 0.5em; }

  /* ===== Popup modal (scoped; safe with multiple sections) ===== */
  #HeroBannerTwo-{{ sid }} .hb2-modal[hidden]{ display:none !important; }
  #HeroBannerTwo-{{ sid }} .hb2-modal{
    position: fixed;
    inset: 0;
    z-index: 9999;
  }
  #HeroBannerTwo-{{ sid }} .hb2-modal__overlay{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.6);
  }
  #HeroBannerTwo-{{ sid }} .hb2-modal__panel{
    position: relative;
    width: min({{ section.settings.popup_max_width | default: 980 }}px, calc(100vw - 24px));
    height: {{ section.settings.popup_height_desktop | default: 'min(80vh, 760px)' }};
    margin: 6vh auto 0;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
  }
  #HeroBannerTwo-{{ sid }} .hb2-modal__close{
    position: absolute;
    top: 10px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: rgba(0,0,0,.08);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }
  #HeroBannerTwo-{{ sid }} .hb2-modal__iframe{
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (max-width: 749px){
    #HeroBannerTwo-{{ sid }} .hb2-modal__panel{
      height: {{ section.settings.popup_height_mobile | default: '78vh' }};
      margin-top: 8vh;
    }
  }
</style>

<script>
(function(){
  var root = document.getElementById('HeroBannerTwo-{{ sid }}');
  if(!root) return;

  /* ========= Popup logic (scoped) ========= */
  function openModal(modalId, src){
    var modal = document.getElementById(modalId);
    if(!modal) return;

    var iframe = modal.querySelector('.hb2-modal__iframe');
    if(iframe){
      if(src) iframe.src = src;
    }

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    var closeBtn = modal.querySelector('[data-hb2-close]');
    if(closeBtn) closeBtn.focus();
  }

  function closeModal(modal){
    if(!modal) return;

    var iframe = modal.querySelector('.hb2-modal__iframe');
    if(iframe) iframe.src = 'about:blank';

    modal.hidden = true;
    document.body.style.overflow = '';
  }

  root.addEventListener('click', function(e){
    var btn = e.target.closest('.js-hb2-open');
    if(!btn) return;
    e.preventDefault();

    openModal(btn.getAttribute('data-hb2-open'), btn.getAttribute('data-hb2-src') || '');
  });

  document.addEventListener('click', function(e){
    var closer = e.target.closest('[data-hb2-close]');
    if(!closer) return;
    var modal = e.target.closest('#{{ modal_id_1 }}, #{{ modal_id_2 }}');
    if(modal) closeModal(modal);
  });

  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;
    var m1 = document.getElementById('{{ modal_id_1 }}');
    var m2 = document.getElementById('{{ modal_id_2 }}');
    if(m1 && !m1.hidden) closeModal(m1);
    if(m2 && !m2.hidden) closeModal(m2);
  });

  /* ========= Word rotator (NO jQuery) ========= */
  var words = Array.prototype.slice.call(root.querySelectorAll('.home-hero__word')).map(function(el){
    return (el.textContent || '').trim();
  }).filter(Boolean);

  var container = root.querySelector('.home-hero__words');
  if(!container || words.length === 0) return;

  var delay = Number({{ section.settings.word_letter_delay | default: 100 }}) || 100;
  var extraStay = Number({{ section.settings.word_extra_stay | default: 1000 }}) || 1000;
  var intervalSec = Number({{ section.settings.word_interval | default: 3 }}) || 3;

  var idx = 0;
  var timer = null;

  function isMobile(){
    return window.matchMedia && window.matchMedia("(max-width: 768px)").matches;
  }

  function splitWordToLetters(word){
    return Array.from(word).map(function(letter){
      if(letter === " "){
        return '<em class="home-hero__letter space">&nbsp;</em>';
      }
      return '<em class="home-hero__letter">' + letter.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</em>';
    }).join("");
  }

  function showWord(i){
    var word = words[i] || '';
    if(isMobile()){
      container.innerHTML = '<span class="home-hero__word-animate">' + word.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</span>';
    }else{
      container.innerHTML = splitWordToLetters(word);
    }
  }

  function animateLettersIn(){
    var letters = root.querySelectorAll('.home-hero__letter');
    letters.forEach(function(el, i){
      window.setTimeout(function(){ el.classList.add('active'); }, i * delay);
    });
  }

  function animateLettersOut(done){
    var letters = root.querySelectorAll('.home-hero__letter');
    var total = (letters.length * delay) + 50;
    letters.forEach(function(el, i){
      window.setTimeout(function(){
        el.classList.remove('active');
        el.classList.add('exit');
      }, i * delay);
    });
    window.setTimeout(function(){ if(done) done(); }, total);
  }

  function animateWordIn(){
    var el = root.querySelector('.home-hero__word-animate');
    if(!el) return;
    el.classList.add('active');
  }

  function animateWordOut(done){
    var el = root.querySelector('.home-hero__word-animate');
    if(!el){ if(done) done(); return; }
    el.classList.remove('active');
    el.classList.add('exit');
    window.setTimeout(function(){ if(done) done(); }, 800);
  }

  function step(){
    var nextIdx = (idx + 1) % words.length;

    if(isMobile()){
      animateWordOut(function(){
        idx = nextIdx;
        showWord(idx);
        animateWordIn();
      });
    }else{
      animateLettersOut(function(){
        idx = nextIdx;
        showWord(idx);
        animateLettersIn();
      });
    }
  }

  function start(){
    stop();
    showWord(idx);
    if(isMobile()) animateWordIn(); else animateLettersIn();
    timer = window.setInterval(step, (intervalSec * 1000) + extraStay);
  }

  function stop(){
    if(timer) window.clearInterval(timer);
    timer = null;
  }

  start();

  window.addEventListener('resize', function(){
    start();
  });

  document.addEventListener('shopify:section:unload', function(evt){
    if(evt && evt.detail && evt.detail.sectionId === '{{ sid }}'){
      stop();
      var m1 = document.getElementById('{{ modal_id_1 }}');
      var m2 = document.getElementById('{{ modal_id_2 }}');
      if(m1 && !m1.hidden) closeModal(m1);
      if(m2 && !m2.hidden) closeModal(m2);
    }
  });
})();
</script>
