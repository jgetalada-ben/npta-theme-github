{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign price = target.price
  assign compare_at_price = target.compare_at_price
  assign available = target.available

  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_compare = compare_at_price | money_with_currency
  else
    assign money_price = price | money
    assign money_compare = compare_at_price | money
  endif

  if compare_at_price > price and compare_at_price > 0
    assign discount_percent = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
    assign discount_amount = compare_at_price | minus: price
    if settings.currency_code_enabled
      assign money_discount_amount = discount_amount | money_with_currency
    else
      assign money_discount_amount = discount_amount | money
    endif
  endif
-%}

{%- unless target == nil -%}
<div
  class="
    price
    {%- if price_class %} {{ price_class }}{% endif -%}
    {%- if available == false %} price--sold-out{% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? != true %} price--on-sale{% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? %} volume-pricing--sale-badge{% endif -%}
    {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
    {%- if show_badges %} price--show-badge{% endif -%}
  "
>
  {%- if compare_at_price > price and compare_at_price > 0 -%}
    <div class="discount">
      {%- if discount_percent > 10 -%}
        {# Pick ONE style: percent or amount #}
        <span>SAVE {{ discount_percent }}%</span>
        {# <span>SAVE {{ money_discount_amount }}</span> #}
      {%- else -%}
        <span>Best Price</span>
      {%- endif -%}
    </div>

    <div class="card-price-wrap">
      <span class="sale-price">{{ money_price }}</span>
      <span class="compare-price">{{ money_compare }}</span>
    </div>
  {%- else -%}
    <div class="card-price-wrap">
      <span class="sale-price">{{ money_price }}</span>
    </div>
  {%- endif -%}
</div>
{%- endunless -%}


    
